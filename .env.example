# Stripe
STRIPE_SECRET_KEY="YOUR_STRIPE_SECRET_KEY"
STRIPE_WEBHOOK_SECRET="YOUR_STRIPE_WEBHOOK_SECRET"
PUBLIC_STRIPE_PRICE_ID="YOUR_STRIPE_SUBSCRIPTION_PRICE_ID"
# 買い切り教材（ログイン必須）。Stripe Dashboard で一回払いの Price ID を作成
PUBLIC_STRIPE_MATERIALS_PRICE_ID=""
# サーバー専用：ログイン済み購入者のみ /api/materials/download からリダイレクト先（ZIP/PDF の直 URL や署名付き URL）
MATERIALS_DOWNLOAD_URL=""
# Webhook が教材決済完了時に Firestore users/{uid} に learning_materials_purchased を書き込む
# 任意：ロードマップ等に表示する価格表記（例 ¥3,980）
PUBLIC_MATERIALS_PRICE_LABEL=""
