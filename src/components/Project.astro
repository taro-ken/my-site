---
const { title, desc, tech, images, image, url, storeUrl } = Astro.props;
// images配列がある場合はそれを使用、なければ単一のimageを使用
const displayImages = images || (image ? [image] : []);
---

<div class="project-card group max-w-2xl mx-auto w-full">
  {displayImages.length > 0 && (
    <div class="project-media mb-8">
      <div class={`grid gap-4 ${displayImages.length > 1 ? 'grid-cols-2' : 'grid-cols-1'}`}>
        {displayImages.map(img => (
          <div class={`relative overflow-hidden rounded-2xl bg-neutral-900 border border-white/5 shadow-2xl ${displayImages.length > 1 ? 'aspect-[3/4]' : 'aspect-video'}`}>
            <img 
              src={img} 
              alt={title} 
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
            />
          </div>
        ))}
      </div>
    </div>
  )}

  <div class="project-content text-center">
    <h3 class="text-xl font-bold mb-2 tracking-tight group-hover:text-primary transition-colors" set:html={title}></h3>
    
    <div class="project-description mb-5">
      <ul class="inline-block text-left space-y-1 text-neutral-400 text-xs leading-relaxed">
        {desc.map(item => (
          <li class="flex items-start gap-2">
            <span class="mt-1 w-1.5 h-1.5 rounded-full bg-primary/40 flex-shrink-0"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="mb-8">
      <div class="text-[10px] uppercase tracking-[0.2em] text-neutral-500 font-bold mb-4">Tech Stack</div>
      <div class="flex flex-wrap gap-2 justify-center">
        {tech.map(techItem => (
          <span class="px-3 py-1.5 text-[11px] bg-white/5 text-neutral-300 rounded-lg border border-white/10">{techItem}</span>
        ))}
      </div>
    </div>

    {(url || storeUrl) && (
      <div class="flex flex-wrap gap-6 items-center justify-center">
        {url && (
          <a href={url} target="_blank" class="text-sm font-semibold text-white hover:text-primary underline underline-offset-8 decoration-white/20 hover:decoration-primary transition-all">
            Visit Website
          </a>
        )}
        {storeUrl && (
          <a href={storeUrl} target="_blank" class="transition-all hover:-translate-y-1 active:scale-95">
            <div class="flex items-center gap-3 bg-white text-black px-5 py-2.5 rounded-xl hover:bg-neutral-100 transition-colors shadow-lg">
              <svg viewBox="0 0 24 24" class="w-6 h-6 fill-current">
                <path d="M16.365 12.49c-.03-3.012 2.463-4.46 2.575-4.53-1.4-2.05-3.58-2.33-4.356-2.36-1.856-.19-3.62 1.1-4.56 1.1-.96 0-2.4-1.08-3.95-1.05-2.03.03-3.92 1.18-4.97 3-2.12 3.68-.54 9.1 1.52 12.08 1.01 1.46 2.2 3.1 3.78 3.04 1.52-.06 2.1-.98 3.95-.98 1.83 0 2.37.98 3.97.94 1.65-.03 2.7-1.49 3.7-2.96 1.16-1.7 1.64-3.35 1.66-3.44-.04-.02-3.19-1.22-3.31-4.8zM13.6 3.87C14.38 2.92 14.91 1.6 14.77.3c-1.12.05-2.47.75-3.26 1.69-.72.83-1.34 2.13-1.17 3.38 1.24.1 2.5-.63 3.26-1.5z"/>
              </svg>
              <div class="leading-tight text-left">
                <div class="text-[9px] uppercase font-black opacity-40">Available on</div>
                <div class="text-sm font-bold tracking-tight">App Store</div>
              </div>
            </div>
          </a>
        )}
      </div>
    )}
  </div>
</div>

<style>
  .project-card {
    position: relative;
    padding: 2rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 2rem;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .project-card:hover {
    background: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.1);
    transform: translateY(-8px);
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.7);
  }

  ul {
    list-style: none !important;
    padding-left: 0 !important;
  }
</style>

