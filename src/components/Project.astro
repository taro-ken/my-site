---
const { title, desc, tech, images, image, url, storeUrl } = Astro.props;
// images配列がある場合はそれを使用、なければ単一のimageを使用
const displayImages = images || (image ? [image] : []);
---

<div class="single-item">
  {displayImages.length > 0 && (
    <div class="project-images-container">
      {displayImages.map(img => (
        <img src={img} alt={title} class="project-image" />
      ))}
    </div>
  )}
  <h3 set:html={title}></h3>
  <div class="project-desc">
    <ul role="list">
      {desc.map(item => <li>{item}</li>)}
    </ul>
  </div>
  <div class="mini-label-dark">Technologies &amp; tools</div>
  <div class="chips-container">
    {tech.map(techItem => <div class="single-chip">{techItem}</div>)}
  </div>
  {(url || storeUrl) && (
    <div class="project-links">
      {url && (
        <a href={url} target="_blank" class="project-link button w-button">
          View Project
        </a>
      )}
      {storeUrl && (
        <a href={storeUrl} target="_blank" class="app-store-badge">
          <div class="badge">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="apple">
              <path fill="currentColor" d="M16.365 12.49c-.03-3.012 2.463-4.46 2.575-4.53-1.4-2.05-3.58-2.33-4.356-2.36-1.856-.19-3.62 1.1-4.56 1.1-.96 0-2.4-1.08-3.95-1.05-2.03.03-3.92 1.18-4.97 3-2.12 3.68-.54 9.1 1.52 12.08 1.01 1.46 2.2 3.1 3.78 3.04 1.52-.06 2.1-.98 3.95-.98 1.83 0 2.37.98 3.97.94 1.65-.03 2.7-1.49 3.7-2.96 1.16-1.7 1.64-3.35 1.66-3.44-.04-.02-3.19-1.22-3.31-4.8zM13.6 3.87C14.38 2.92 14.91 1.6 14.77.3c-1.12.05-2.47.75-3.26 1.69-.72.83-1.34 2.13-1.17 3.38 1.24.1 2.5-.63 3.26-1.5z"/>
            </svg>
            <div class="text">
              <span class="small">Download on the</span>
              <span class="big">App Store</span>
            </div>
          </div>
        </a>
      )}
    </div>
  )}
</div>

<style>
  .project-images-container {
    margin-bottom: 1rem;
    display: flex;
    gap: 1rem;
  }
  
  .project-image {
    width: 100%;
    height: auto;
    border-radius: 8px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    flex: 1;
  }
  
  /* 複数画像の場合は画面幅に合わせて調整 */
  .project-images-container .project-image {
    max-width: calc(50% - 0.5rem);
    min-width: 0;
  }
  
  /* 単一画像の場合は幅一杯に */
  .project-images-container .project-image:only-child {
    max-width: none;
    min-width: unset;
    flex: none;
  }
  
  @media (max-width: 768px) {
    .project-images-container {
      gap: 0.5rem;
    }
    
    /* モバイルでも複数画像は横並び、画面幅に収まるサイズに */
    .project-images-container .project-image {
      max-width: calc(50% - 0.25rem);
      min-width: 0;
    }
    
    /* モバイルでも単一画像は幅一杯に */
    .project-images-container .project-image:only-child {
      min-width: unset;
      max-width: none;
    }
  }
  
  .project-links {
    margin-top: 1rem;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  
  .project-link {
    display: inline-block;
    padding: 0.5rem 1rem;
    background-color: #007acc;
    color: white;
    text-decoration: none;
    border-radius: 4px;
    font-size: 0.9rem;
    transition: background-color 0.2s;
  }
  
  .project-link:hover {
    background-color: #005a99;
  }
  
  /* タイトルを1行で収める */
  .single-item h3 {
    font-size: 1.4rem;
    margin: 0.8rem 0 0.6rem 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.2;
    max-width: 100%;
  }
  
  /* 長いタイトルの場合は文字サイズを自動調整 */
  @media (max-width: 768px) {
    .single-item h3 {
      font-size: 1.2rem;
    }
  }
  
  @media (max-width: 480px) {
    .single-item h3 {
      font-size: 1rem;
    }
  }
  
  /* 説明文を小さく */
  .project-desc {
    font-size: 0.8rem;
    line-height: 1.4;
  }

  /* スマホで説明文が1行に収まるように自動調整 */
  @media (max-width: 768px) {
    .project-desc {
      font-size: clamp(0.6rem, 3vw, 0.8rem);
      line-height: 1.2;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
  
  .project-desc ul {
    margin: 0.6rem 0;
    padding-left: 0;
    list-style: none;
  }
  
  .project-desc li {
    margin: 0.3rem 0;
  }

  /* スマホでリストアイテムも1行に収まるように */
  @media (max-width: 768px) {
    .project-desc li {
      font-size: clamp(0.6rem, 3vw, 0.8rem);
      line-height: 1.2;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      margin: 0.2rem 0;
    }
  }
  
  /* ツールチップを小さく */
  .mini-label-white {
    font-size: 0.8rem;
    margin: 0.8rem 0 0.4rem 0;
  }

  /* ツールラベルを黒に */
  .mini-label-dark {
    font-size: 0.8rem;
    margin: 0.8rem 0 0.4rem 0;
    color: #333;
    text-align: center;
  }
  
  .chips-container {
    margin: 0.4rem 0;
  }
  
  .single-chip {
    font-size: 0.6rem;
    padding: 0.2rem 0.4rem;
    margin: 0.15rem 0.2rem 0.15rem 0;
  }
  
  /* すべての要素を中央揃え */
  .single-item {
    text-align: center;
  }
  
  .single-item h3 {
    text-align: center;
  }
  
  .project-desc {
    text-align: center;
  }
  
  .project-desc ul {
    text-align: center;
  }
  
  .project-desc li {
    text-align: center;
  }

  /* App Storeバッジのスタイル */
  .app-store-badge {
    text-decoration: none;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #000;
    color: #fff;
    height: 40px;
    padding: 0 14px;
    border-radius: 12px;
  }

  .apple {
    width: 22px;
    height: 22px;
  }

  .text { 
    display: grid; 
    line-height: 1; 
  }

  .small { 
    font-size: 11px; 
    opacity: .9; 
  }

  .big { 
    font-size: 18px; 
    font-weight: 600; 
    letter-spacing: .2px; 
  }

  @media (min-width: 768px){
    .badge{ height: 46px; padding: 0 16px; border-radius: 14px; }
    .apple{ width: 24px; height: 24px; }
    .small{ font-size: 12px; }
    .big{ font-size: 20px; font-weight: 600; }
  }
  
  .mini-label-white {
    text-align: center;
  }
  
  .chips-container {
    justify-content: center;
    display: flex;
    flex-wrap: wrap;
  }
  
  .project-links {
    justify-content: center;
  }
</style>
