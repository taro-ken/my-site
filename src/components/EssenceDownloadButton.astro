---
// Essenceへの参加ボタン。登録(/register)に進み、ログイン後にStripe決済へ進む。
// 審査対応のため、アプリ内で決済を始めることはない(Webでの登録・決済のみ)。
interface Props {
  href?: string;
  size?: 'md' | 'lg';
  full?: boolean;
  class?: string;
}

import { ESSENCE_JOIN_OPEN } from '../lib/essence';

const { href = '/register', size = 'md', full = false, class: className = '' } = Astro.props;
const isPreparing = !ESSENCE_JOIN_OPEN;
---

{isPreparing ? (
  <span role="button" aria-disabled="true" class:list={['dl-btn', 'is-disabled', size, { full }, className]}>
    準備中
  </span>
) : (
  <a href={href} class:list={['dl-btn', size, { full }, className]}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    Essenceに参加する
  </a>
)}

<style>
  .dl-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.55rem 1rem;
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: #04130d;
    background: linear-gradient(100deg, #6ee7b7, #22d3ee);
    box-shadow: 0 10px 40px -10px rgba(52, 211, 153, 0.7);
    transition: transform 0.25s ease, box-shadow 0.25s ease, filter 0.25s ease;
    white-space: nowrap;
  }
  .dl-btn svg { width: 1.05em; height: 1.05em; }
  a.dl-btn:hover {
    transform: translateY(-2px);
    filter: brightness(1.06);
    box-shadow: 0 16px 50px -10px rgba(52, 211, 153, 0.85);
  }
  .dl-btn.is-disabled {
    color: #a1a1aa;
    background: #27272a;
    box-shadow: none;
    cursor: not-allowed;
    user-select: none;
  }
  .dl-btn.full { display: flex; width: 100%; }
  @media (min-width: 640px) {
    .dl-btn { padding: 0.875rem 1.75rem; font-size: 0.875rem; }
    .dl-btn.lg { padding: 1.05rem 2.25rem; font-size: 1rem; }
  }
</style>
