---
// Essenceへの参加ボタン。登録(/register)に進み、ログイン後にStripe決済へ進む。
// 審査対応のため、アプリ内で決済を始めることはない(Webでの登録・決済のみ)。
interface Props {
  href?: string;
  size?: 'md' | 'lg';
  full?: boolean;
  class?: string;
  /** 開いているときのボタン文言。未指定は「Essenceに参加する」 */
  label?: string;
}

import { ESSENCE_JOIN_OPEN } from '../lib/essence';

const {
  href = '/register',
  size = 'md',
  full = false,
  class: className = '',
  label = 'Essenceに参加する',
} = Astro.props;
const isPreparing = !ESSENCE_JOIN_OPEN;
---

{isPreparing ? (
  <span role="button" aria-disabled="true" class:list={['dl-btn', 'is-disabled', size, { full }, className]}>
    準備中
  </span>
) : (
  <a href={href} class:list={['dl-btn', size, { full }, className]}>
    {label}
  </a>
)}

<style>
  .dl-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.55rem 1rem;
    border-radius: 2px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: #02110c;
    background: linear-gradient(100deg, #7ccaae, #66b4c6);
    box-shadow: 0 6px 18px -12px rgba(79, 152, 168, 0.3);
    transition: transform 0.25s ease, box-shadow 0.25s ease, filter 0.25s ease;
    white-space: nowrap;
  }
  a.dl-btn:hover {
    transform: translateY(-2px);
    filter: brightness(1.06);
    box-shadow: 0 8px 20px -12px rgba(79, 152, 168, 0.4);
  }
  .dl-btn.is-disabled {
    color: #a1a1aa;
    background: #27272a;
    box-shadow: none;
    cursor: not-allowed;
    user-select: none;
  }
  .dl-btn.full { display: flex; width: 100%; }
  @media (min-width: 640px) {
    .dl-btn { padding: 0.875rem 1.75rem; font-size: 0.875rem; }
    .dl-btn.lg { padding: 1.05rem 2.25rem; font-size: 1rem; }
  }
</style>
