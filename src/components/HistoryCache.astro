---
/**
 * ClientRouter は戻る/進む(スワイプバック含む)でも毎回サーバーから HTML を取得し直すため、
 * 応答待ちの間は元の画面のまま残り「戻れていない」ように見える。
 * 一度表示したページの HTML をメモリに保持し、履歴移動の時だけ即座に差し替える。
 */
---

<script>
	import type { TransitionBeforePreparationEvent } from 'astro:transitions/client';

	const MAX_ENTRIES = 20;
	const cache = new Map<string, string>();
	const keyOf = (url: URL) => url.pathname + url.search;

	const remember = (url: URL, html: string) => {
		const key = keyOf(url);
		cache.delete(key);
		cache.set(key, html);
		if (cache.size > MAX_ENTRIES) cache.delete(cache.keys().next().value!);
	};

	// 最初に直接開いたページは DOM がスクリプトで書き換わっているため、素の HTML を取り直して保持する
	const initialUrl = new URL(location.href);
	const idle = window.requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 1500));
	idle(() => {
		fetch(initialUrl.href, { credentials: 'same-origin' })
			.then((res) => (res.ok && res.headers.get('content-type')?.includes('text/html') ? res.text() : null))
			.then((html) => {
				if (html && !cache.has(keyOf(initialUrl))) remember(initialUrl, html);
			})
			.catch(() => {});
	});

	document.addEventListener('astro:before-preparation', (event) => {
		const e = event as TransitionBeforePreparationEvent;
		const originalLoader = e.loader;
		e.loader = async () => {
			const cached = e.navigationType === 'traverse' ? cache.get(keyOf(e.to)) : undefined;
			if (cached) {
				e.newDocument = new DOMParser().parseFromString(cached, 'text/html');
				e.newDocument.querySelectorAll('noscript').forEach((el) => el.remove());
				return;
			}
			await originalLoader();
			if (!e.defaultPrevented && e.newDocument) {
				remember(e.to, '<!doctype html>' + e.newDocument.documentElement.outerHTML);
			}
		};
	});
</script>
