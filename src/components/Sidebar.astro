---
const { selectedItem } = Astro.props;
---

<aside
  data-animation="default"
  data-collapse="medium"
  data-duration="400"
  data-easing="ease"
  data-easing2="ease"
  role="banner"
  class="sidebar w-nav"
>
  <div class="nav-content">
    <a href="/" class="w-nav-brand" aria-label="home">
      <div class="niv-data">
        <img
          src="/assets/webicon.png"
          loading="eager"
          alt="Profile picture"
          class="niv-image"
        />
        <div>
          <div class="label-white">taro.</div>
          <div class="label-gray">iOS Developer</div>
        </div>
      </div>
    </a>

    <nav role="navigation" class="w-nav-menu">
      <!-- モバイル用クローズボタン -->
      <button class="mobile-close-button" aria-label="メニューを閉じる">
        ×
      </button>
      
      <!-- ナビゲーションリンク -->
      <a
        href="/"
        class={`nav-link-container w-inline-block ${
          selectedItem === 'home' ? 'w--current' : ''
        }`}
      >
        <div>Home</div>
      </a>
      <a
        href="/personal-projects"
        class={`nav-link-container w-inline-block ${
          selectedItem === 'personal-projects' ? 'w--current' : ''
        }`}
      >
        <div>Personal projects</div>
      </a>
      <a
        href="/services"
        class={`nav-link-container w-inline-block ${
          selectedItem === 'services' ? 'w--current' : ''
        }`}
      >
        <div>Services</div>
      </a>
      <a
        href="/all-item-list"
        class={`nav-link-container w-inline-block ${
          selectedItem === 'all-item-list' ? 'w--current' : ''
        }`}
        aria-current={
          selectedItem === 'all-item-list' ? 'page' : undefined
        }
      >
        <div>All Item List</div>
      </a>
      <a
        href="/contact"
        class={`nav-link-container w-inline-block ${
          selectedItem === 'contact' ? 'w--current' : ''
        }`}
      >
        <div>Contact</div>
      </a>
    </nav>

    <div
      class="navbar-icon-button w-nav-button"
      style="-webkit-user-select: text;"
      aria-label="menu"
      role="button"
      tabindex="0"
    >
      <img
        src="/assets/menu.svg"
        loading="eager"
        alt=""
        class="navbar-icon"
      />
    </div>
  </div>

  <script>
    import { setupNav } from '../scripts/nav.js';
    
    let cleanup;
    document.addEventListener('astro:page-load', () => {
      if (cleanup) cleanup();
      cleanup = setupNav();
    });

    document.addEventListener('astro:before-swap', () => {
      if (cleanup) cleanup();
    });
  </script>
</aside>
