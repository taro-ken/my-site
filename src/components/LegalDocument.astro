---
import Layout from '../layouts/Layout.astro';

interface Props {
  title: string;
  subtitle?: string;
  description: string;
  established: string;
  revised: string;
}

const { title, subtitle, description, established, revised } = Astro.props;
---

<Layout title={`${title} - taro.`} description={description}>
  <main class="min-h-screen bg-black text-white pt-32 pb-32 px-5 font-sans font-normal selection:bg-white selection:text-black">
    <div class="max-w-2xl mx-auto w-full">
      <div class="text-center mb-16">
        <h1 class="text-3xl md:text-4xl font-black tracking-tight mb-4">
          {title}
          {subtitle && <><br /><span class="text-xl md:text-2xl text-zinc-500">{subtitle}</span></>}
        </h1>
      </div>

      <div class="legal space-y-12">
        <slot />
      </div>

      <div class="mt-20 text-right text-[10px] text-zinc-600 space-y-1">
        <p>制定日：{established}</p>
        <p>最終改定日：{revised}</p>
      </div>

      <nav class="mt-24 border-t border-zinc-900 pt-12 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-xs text-zinc-500">
        <a href="/essence" class="hover:text-white underline underline-offset-8 transition-colors">Essence</a>
        <a href="/privacy" class="hover:text-white underline underline-offset-8 transition-colors">プライバシーポリシー</a>
        <a href="/terms" class="hover:text-white underline underline-offset-8 transition-colors">利用規約</a>
        <a href="/tokushoho" class="hover:text-white underline underline-offset-8 transition-colors">特定商取引法に基づく表記</a>
      </nav>
    </div>
  </main>
</Layout>

<style is:global>
  .legal h2 {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #71717a;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #18181b;
  }
  .legal p,
  .legal li {
    font-size: 0.875rem;
    line-height: 1.9;
    color: #d4d4d8;
  }
  .legal p + p { margin-top: 0.75rem; }
  .legal ul { margin-top: 0.75rem; padding-left: 1.25rem; list-style: disc; }
  .legal ul li + li { margin-top: 0.4rem; }
  .legal ol { margin-top: 0.75rem; padding-left: 1.25rem; list-style: decimal; }
  .legal ol li + li { margin-top: 0.4rem; }
  .legal strong { color: #fff; font-weight: 700; }
  .legal a { text-decoration: underline; text-underline-offset: 4px; }
  .legal a:hover { color: #fff; }
</style>
