---
import vercelAnalytics from '@vercel/analytics/astro';
import vercelSpeedInsights from '@vercel/speed-insights/astro';
import Navigation from '../components/Navigation.astro';
import '../styles/global.css';

const Analytics = vercelAnalytics;
const SpeedInsights = vercelSpeedInsights;

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  hideNav?: boolean;
}

const { 
  title,
  description = "Taro Essence | クリエイター・ミニマリズム実践者。YouTube などで発信。ライフスタイルデザインや自己啓発、テクノロジーについて。",
  keywords = "Taro Essence, taro., ミニマリスト, 習慣, 自己啓発, サイドFIRE, YouTube",
  ogImage = "/assets/webicon.png",
  canonicalUrl,
  ogType = "website",
  hideNav = false
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || "https://kentaro.life";
const currentUrl = canonicalUrl || `${siteUrl}${Astro.url.pathname}`;
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage.startsWith('/') ? ogImage : '/' + ogImage}`;

// Global session and premium status check from middleware
const { isLoggedIn, isPremium } = Astro.locals;
---

<!doctype html>
<html lang="ja" class="bg-black text-white">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
		<link rel="icon" type="image/png" href="/assets/webicon.png" />
		<meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Taro Essence" />
    <meta name="robots" content="index, follow" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:site_name" content="Taro Essence" />
    <meta property="og:locale" content="ja_JP" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={currentUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <link rel="canonical" href={currentUrl} />

    <!-- Google Search Console -->
    <meta name="google-site-verification" content="VzFebweoHfSUMDIuEQc2sgzHkvI7jwvZZIcTbgs2rVM" />


    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ogType === 'article' ? "BlogPosting" : "Person",
      "name": "Taro Essence",
      "alternateName": "taro.",
      "url": siteUrl,
      "description": description,
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": currentUrl
      }
    })} />
	</head>
	<body class="bg-black min-h-screen">
		<div id="loading-bar-container">
			<div id="loading-bar"></div>
		</div>
		{!hideNav && <Navigation isLoggedIn={isLoggedIn} isPremium={isPremium} />}
		<slot />
		<Analytics />
		<SpeedInsights />

		<script>
			// Basic Page Load Reset
			window.addEventListener('pageshow', (event) => {
				const container = document.getElementById('loading-bar-container');
				if (container) {
					container.classList.remove('loading');
					const bar = document.getElementById('loading-bar');
					if (bar) bar.style.width = '0%';
				}
			});
		</script>
	</body>
</html>
<style is:global>
	:root {
		--accent: 136, 58, 234;
		--accent-light: 224, 204, 250;
		--accent-dark: 49, 10, 101;
		--accent-gradient: linear-gradient(
			45deg,
			rgb(var(--accent)),
			rgb(var(--accent-light)) 30%,
			white 60%
		);
	}
	html {
		font-family: system-ui, sans-serif;
	}
	code {
		font-family:
			Menlo,
			Monaco,
			Lucida Console,
			Liberation Mono,
			DejaVu Sans Mono,
			Bitstream Vera Sans Mono,
			Courier New,
			monospace;
	}
</style>
