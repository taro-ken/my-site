---
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
---

<!DOCTYPE html>
<html>
  <Header title="Contact | KENTARO" />
  <body>
    <div class="content">
        <Sidebar selectedItem="contact" />
      <nav class="main">
        <div class="container">
          <div class="back-nav-container">
            <a href="/" class="back-nav-button w-inline-block"
              ><img src="/assets/back.svg" loading="lazy" alt="" class="back-nav-img" />
              <div>Back</div></a
            >
          </div>
          <div class="content-container">
            <section class="items-container">
              <div class="contact-form-container">
                <iframe 
                  src="https://forms.gle/DUWmrhrD2JUZKCgD6"
                  width="100%" 
                  height="1200" 
                  frameborder="0" 
                  marginheight="0" 
                  marginwidth="0"
                  class="contact-form-iframe"
                  title="Contact Form"
                >
                  お使いのブラウザがiframeをサポートしていません。
                  <a href="https://forms.gle/DUWmrhrD2JUZKCgD6" target="_blank" class="contact-form-link">
                    こちらからお問い合わせフォームを開いてください
                  </a>
                </iframe>
              </div>
            </section>
          </div>
        </div>
      </nav>
    </div>

    <!--[if lte IE 9]><script src="//cdnjs.cloudflare.com/ajax/libs/placeholders/3.0.2/placeholders.min.js"></script><![endif]-->
  </body>
</html>

<style>
  .contact-form-container {
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .contact-form-iframe {
    width: 100%;
    border-radius: 0;
    border: none;
    background: white;
    margin-left: -30px;
    margin-right: -30px;
    width: calc(100% + 60px);
    max-width: 100vw;
    box-sizing: border-box;
  }

  .contact-form-link {
    color: #3b82f6;
    text-decoration: underline;
  }

  .content-container {
    padding-left: 0;
    padding-right: 0;
    margin: 0;
    width: 100%;
  }

  .items-container {
    padding-left: 0;
    padding-right: 0;
    margin: 0;
    width: 100%;
  }

  .container {
    padding-left: 0;
    padding-right: 0;
  }


  @media (max-width: 768px) {
    .contact-form-container {
      margin: 0;
      padding: 0;
      width: 100vw;
      max-width: 100vw;
      overflow: hidden;
    }
    
    .contact-form-iframe {
      height: 150vh;
      margin: 0;
      padding: 0;
      width: 100vw;
      max-width: 100vw;
      position: relative;
      left: 0;
      overflow: hidden;
    }
    
    .content-container,
    .items-container,
    .container,
    .main {
      padding: 0 !important;
      margin: 0 !important;
      width: 100vw !important;
      max-width: 100vw !important;
      box-sizing: border-box;
    }
    
    body {
      overflow-x: hidden;
      margin: 0;
      padding: 0;
    }
    
    .back-nav-container {
      padding: 0 !important;
      margin: 0 !important;
      margin-left: 30px !important;
    }
    
    .back-nav-button {
      margin-top: -12px !important;
      padding: 12px 16px !important;
    }
  }
</style>
