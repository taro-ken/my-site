---
import Layout from '../../layouts/Layout.astro';
import { requireAdmin } from '../../lib/admin';
import { adminDb } from '../../lib/firebase/server';

const admin = await requireAdmin(Astro.cookies);
if (!admin) {
  return Astro.redirect('/');
}

const coursesSnapshot = await adminDb
  .collection('courses')
  .orderBy('position', 'asc')
  .get();

const courses = await Promise.all(
  coursesSnapshot.docs.map(async (doc) => {
    const data = doc.data();
    const lessonsSnapshot = await doc.ref.collection('lessons').orderBy('position', 'asc').get();
    const lessons = lessonsSnapshot.docs.map((lessonDoc) => {
      const lessonData = lessonDoc.data();
      return {
        id: lessonDoc.id,
        title: lessonData.title as string,
        description: (lessonData.description as string) ?? '',
        chapterTitle: (lessonData.chapterTitle as string) ?? null,
      };
    });
    return {
      id: doc.id,
      title: data.title as string,
      description: (data.description as string) ?? '',
      thumbnailUrl: (data.thumbnailUrl as string) ?? '',
      category: (data.category as string) ?? '',
      lessons,
    };
  })
);
const categories = [...new Set(courses.map((course) => course.category).filter(Boolean))].sort();
---

<Layout title="講座管理 | Taro Essence" description="スキル講座・レッスンの管理(管理者専用)">
  <main class="min-h-screen bg-black text-white p-8 pt-24 max-w-2xl mx-auto">
    <h1 class="text-2xl md:text-4xl font-black tracking-tight mb-10">講座管理</h1>

    <datalist id="course-categories">
      {categories.map((category) => <option value={category} />)}
    </datalist>

    <form id="course-form" class="p-6 rounded-2xl bg-zinc-950 border border-white/10 shadow-xl space-y-5">
      <h2 class="text-sm font-bold uppercase tracking-wider text-zinc-500">新しい講座を作成</h2>
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-zinc-500 mb-2">タイトル</label>
        <input name="title" type="text" required
          class="w-full px-4 py-3 rounded-md bg-black border border-white/10 text-white text-sm focus:outline-none focus:border-white/30" />
      </div>
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-zinc-500 mb-2">説明</label>
        <textarea name="description" rows="3"
          class="w-full px-4 py-3 rounded-md bg-black border border-white/10 text-white text-sm focus:outline-none focus:border-white/30 resize-y"></textarea>
      </div>
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-zinc-500 mb-2">ジャンル(任意)</label>
        <input name="category" type="text" list="course-categories" placeholder="例: デジタルスキル、ヘルスケア"
          class="w-full px-4 py-3 rounded-md bg-black border border-white/10 text-white text-sm focus:outline-none focus:border-white/30" />
        <p class="text-[10px] text-zinc-500 mt-2">アプリの講座一覧で、このジャンルで絞り込めるようになります。既存のジャンルは候補から選べます。</p>
      </div>
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-zinc-500 mb-2">サムネイル画像(任意)</label>
        <input name="thumbnail" type="file" accept="image/jpeg,image/png,image/webp"
          class="w-full text-xs text-zinc-300 file:mr-3 file:py-2 file:px-3 file:rounded-md file:border-0 file:bg-white/10 file:text-white file:text-[10px] file:font-bold file:uppercase file:tracking-wider" />
        <p class="text-[10px] text-zinc-500 mt-2">JPEG・PNG・WebP、4MB まで。アプリでは 16:10 で表示されます。</p>
      </div>
      <button type="submit" id="course-submit-btn"
        class="w-full py-3 px-4 bg-white text-black font-bold text-sm tracking-wide rounded-md hover:bg-zinc-200 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
        講座を作成
      </button>
      <p id="course-status" class="text-sm text-center min-h-[1.25rem]"></p>
    </form>

    <div class="space-y-4 mt-10">
      {courses.length === 0 && <p class="text-sm text-zinc-500">まだ講座がありません。</p>}
      {courses.map((course) => (
        <div class="course-card p-4 rounded-xl bg-zinc-950 border border-white/10" data-course-id={course.id}>
          <div class="edit-row flex items-start justify-between gap-4">
            <label class="thumbnail-picker relative shrink-0 w-24 aspect-[16/10] rounded-md overflow-hidden bg-white/5 border border-white/10 cursor-pointer group" title="サムネイルを変更">
              {course.thumbnailUrl
                ? <img src={course.thumbnailUrl} alt="" class="w-full h-full object-cover" />
                : <span class="absolute inset-0 flex items-center justify-center text-[10px] text-zinc-500">画像なし</span>}
              <span class="thumbnail-label absolute inset-0 flex items-center justify-center bg-black/60 text-[10px] font-bold opacity-0 group-hover:opacity-100 transition-opacity">変更</span>
              <input type="file" accept="image/jpeg,image/png,image/webp" class="thumbnail-input hidden" data-course-id={course.id} />
            </label>
            <div class="min-w-0 flex-1">
              <div class="edit-view">
                {course.category && (
                  <span class="inline-block mb-1 px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 text-[10px] font-bold">{course.category}</span>
                )}
                <p class="font-bold text-sm">{course.title}</p>
                {course.description && (
                  <details class="desc-accordion mt-1">
                    <summary class="text-[11px] font-bold text-zinc-500 hover:text-zinc-300">概要を表示</summary>
                    <p class="text-xs text-zinc-400 mt-1 whitespace-pre-wrap">{course.description}</p>
                  </details>
                )}
              </div>
              <form class="edit-form course-edit-form hidden space-y-2" data-course-id={course.id}>
                <input name="title" type="text" value={course.title} required placeholder="タイトル"
                  class="w-full px-3 py-2 rounded-md bg-black border border-white/10 text-white text-xs focus:outline-none focus:border-white/30" />
                <textarea name="description" rows="3" placeholder="説明"
                  class="w-full px-3 py-2 rounded-md bg-black border border-white/10 text-white text-xs focus:outline-none focus:border-white/30 resize-y">{course.description}</textarea>
                <input name="category" type="text" list="course-categories" value={course.category} placeholder="ジャンル(任意)"
                  class="w-full px-3 py-2 rounded-md bg-black border border-white/10 text-white text-xs focus:outline-none focus:border-white/30" />
                <div class="flex gap-2">
                  <button type="submit" class="edit-save-btn px-3 py-1.5 rounded-md bg-white text-black text-xs font-bold hover:bg-zinc-200 transition-colors disabled:opacity-50">保存</button>
                  <button type="button" class="edit-cancel-btn px-3 py-1.5 rounded-md bg-white/10 text-white text-xs font-bold hover:bg-white/20 transition-colors">キャンセル</button>
                </div>
                <p class="edit-status text-xs text-red-400"></p>
              </form>
            </div>
            <div class="shrink-0 flex flex-col items-end gap-2">
              <button class="edit-toggle-btn px-3 py-1.5 rounded-md bg-white/10 hover:bg-white/20 text-white text-xs font-bold transition-colors">
                編集
              </button>
              <button
                data-delete-course={course.id}
                data-delete-title={course.title}
                class="delete-course-btn px-3 py-1.5 rounded-md bg-red-500/10 hover:bg-red-500/20 text-red-400 text-xs font-bold transition-colors"
              >
                講座ごと削除
              </button>
            </div>
          </div>

          <div class="mt-4 pl-4 border-l border-white/10 space-y-3">
            {course.lessons.map((lesson) => (
              <div class="edit-row flex items-start justify-between gap-3">
                <div class="min-w-0 flex-1">
                  <div class="edit-view">
                    {lesson.chapterTitle && <p class="text-[10px] font-bold text-emerald-400 mb-0.5">{lesson.chapterTitle}</p>}
                    <p class="text-xs font-bold text-zinc-200">{lesson.title}</p>
                    {lesson.description && (
                      <details class="desc-accordion mt-0.5">
                        <summary class="text-[11px] font-bold text-zinc-500 hover:text-zinc-300">概要を表示</summary>
                        <p class="text-[11px] text-zinc-500 mt-1 whitespace-pre-wrap">{lesson.description}</p>
                      </details>
                    )}
                  </div>
                  <form class="edit-form lesson-edit-form hidden space-y-2" data-course-id={course.id} data-lesson-id={lesson.id}>
                    <input name="chapterTitle" type="text" value={lesson.chapterTitle ?? ''} placeholder="章タイトル(任意)"
                      class="w-full px-3 py-2 rounded-md bg-black border border-white/10 text-white text-xs focus:outline-none focus:border-white/30" />
                    <input name="title" type="text" value={lesson.title} required placeholder="レッスンタイトル"
                      class="w-full px-3 py-2 rounded-md bg-black border border-white/10 text-white text-xs focus:outline-none focus:border-white/30" />
                    <textarea name="description" rows="3" placeholder="説明(任意)"
                      class="w-full px-3 py-2 rounded-md bg-black border border-white/10 text-white text-xs focus:outline-none focus:border-white/30 resize-y">{lesson.description}</textarea>
                    <label class="block text-[10px] text-zinc-500">動画を差し替える場合のみ選択</label>
                    <input name="video" type="file" accept="video/*"
                      class="w-full text-xs text-zinc-300 file:mr-3 file:py-2 file:px-3 file:rounded-md file:border-0 file:bg-white/10 file:text-white file:text-[10px] file:font-bold file:uppercase file:tracking-wider" />
                    <div class="flex gap-2">
                      <button type="submit" class="edit-save-btn px-3 py-1.5 rounded-md bg-white text-black text-xs font-bold hover:bg-zinc-200 transition-colors disabled:opacity-50">保存</button>
                      <button type="button" class="edit-cancel-btn px-3 py-1.5 rounded-md bg-white/10 text-white text-xs font-bold hover:bg-white/20 transition-colors">キャンセル</button>
                    </div>
                    <p class="edit-status text-xs text-red-400"></p>
                  </form>
                </div>
                <div class="shrink-0 flex gap-1.5">
                  <button class="edit-toggle-btn px-2 py-1 rounded-md bg-white/10 hover:bg-white/20 text-white text-[10px] font-bold transition-colors">
                    編集
                  </button>
                  <button
                    data-delete-lesson={lesson.id}
                    data-course-id={course.id}
                    class="delete-lesson-btn px-2 py-1 rounded-md bg-red-500/10 hover:bg-red-500/20 text-red-400 text-[10px] font-bold transition-colors"
                  >
                    削除
                  </button>
                </div>
              </div>
            ))}
          </div>

          <form class="lesson-form mt-4 pt-4 border-t border-white/10 space-y-2" data-course-id={course.id}>
            <input name="chapterTitle" type="text" placeholder="章タイトル(任意)"
              class="w-full px-3 py-2 rounded-md bg-black border border-white/10 text-white text-xs focus:outline-none focus:border-white/30" />
            <input name="title" type="text" placeholder="レッスンタイトル" required
              class="w-full px-3 py-2 rounded-md bg-black border border-white/10 text-white text-xs focus:outline-none focus:border-white/30" />
            <textarea name="description" rows="2" placeholder="説明(任意)"
              class="w-full px-3 py-2 rounded-md bg-black border border-white/10 text-white text-xs focus:outline-none focus:border-white/30 resize-y"></textarea>
            <input name="video" type="file" accept="video/*" required
              class="w-full text-xs text-zinc-300 file:mr-3 file:py-2 file:px-3 file:rounded-md file:border-0 file:bg-white/10 file:text-white file:text-[10px] file:font-bold file:uppercase file:tracking-wider" />
            <p class="text-[10px] text-zinc-500">書き出し時に「Web最適化/Fast Start」をオンにすると、アプリでの再生開始が速くなります。</p>
            <button type="submit"
              class="lesson-submit-btn w-full py-2 px-4 bg-white/10 text-white text-xs font-bold rounded-md hover:bg-white/20 transition-colors disabled:opacity-50">
              レッスンを追加
            </button>
            <p class="lesson-status text-xs text-red-400"></p>
          </form>
        </div>
      ))}
    </div>
  </main>
</Layout>

<style>
  .desc-accordion > summary {
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    user-select: none;
  }
  .desc-accordion > summary::-webkit-details-marker {
    display: none;
  }
  .desc-accordion > summary::before {
    content: '▸';
    transition: transform 0.15s;
  }
  .desc-accordion[open] > summary::before {
    transform: rotate(90deg);
  }
  .desc-accordion[open] > summary {
    font-size: 0;
  }
  .desc-accordion[open] > summary::before {
    font-size: 11px;
  }
  .desc-accordion[open] > summary::after {
    content: '概要を閉じる';
    font-size: 11px;
  }
</style>

<script>
  const courseForm = document.getElementById('course-form') as HTMLFormElement;
  const courseSubmitBtn = document.getElementById('course-submit-btn') as HTMLButtonElement;
  const courseStatusEl = document.getElementById('course-status') as HTMLParagraphElement;

  async function uploadThumbnail(courseId: string, file: File) {
    const body = new FormData();
    body.append('image', file);
    const res = await fetch(`/api/admin/courses/${courseId}/thumbnail`, { method: 'POST', body });
    if (!res.ok) {
      const err = await res.json().catch(() => ({}));
      throw new Error(err.error || 'サムネイルのアップロードに失敗しました');
    }
  }

  courseForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    courseSubmitBtn.disabled = true;
    courseStatusEl.textContent = '';
    courseStatusEl.classList.remove('text-red-400', 'text-emerald-400');

    try {
      const formData = new FormData(courseForm);
      const res = await fetch('/api/admin/courses/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title: formData.get('title'),
          description: formData.get('description'),
          category: formData.get('category'),
        }),
      });
      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        throw new Error(err.error || '作成に失敗しました');
      }
      const { id } = await res.json();

      const thumbnail = formData.get('thumbnail') as File | null;
      if (thumbnail && thumbnail.size > 0) {
        courseStatusEl.textContent = 'サムネイルをアップロード中...';
        try {
          await uploadThumbnail(id, thumbnail);
        } catch (error) {
          const message = error instanceof Error ? error.message : 'サムネイルのアップロードに失敗しました';
          alert(`講座は作成しましたが、${message}。講座一覧の画像枠から再度設定してください。`);
          window.location.reload();
          return;
        }
      }
      courseStatusEl.textContent = '作成しました。';
      courseStatusEl.classList.add('text-emerald-400');
      setTimeout(() => window.location.reload(), 500);
    } catch (error) {
      courseStatusEl.textContent = error instanceof Error ? error.message : '予期せぬエラーが発生しました';
      courseStatusEl.classList.add('text-red-400');
      courseSubmitBtn.disabled = false;
    }
  });

  document.querySelectorAll<HTMLInputElement>('.thumbnail-input').forEach((input) => {
    input.addEventListener('change', async () => {
      const file = input.files?.[0];
      if (!file) return;
      const label = input.closest('.thumbnail-picker')?.querySelector<HTMLSpanElement>('.thumbnail-label');
      if (label) {
        label.textContent = 'アップロード中...';
        label.classList.remove('opacity-0');
      }
      try {
        await uploadThumbnail(input.dataset.courseId!, file);
        window.location.reload();
      } catch (error) {
        alert(error instanceof Error ? error.message : 'サムネイルのアップロードに失敗しました');
        if (label) {
          label.textContent = '変更';
          label.classList.add('opacity-0');
        }
        input.value = '';
      }
    });
  });

  function setEditing(row: Element, editing: boolean) {
    row.querySelector('.edit-view')?.classList.toggle('hidden', editing);
    row.querySelector('.edit-form')?.classList.toggle('hidden', !editing);
    row.querySelector('.edit-toggle-btn')?.classList.toggle('hidden', editing);
  }

  document.querySelectorAll<HTMLButtonElement>('.edit-toggle-btn').forEach((btn) => {
    btn.addEventListener('click', () => setEditing(btn.closest('.edit-row')!, true));
  });

  document.querySelectorAll<HTMLFormElement>('.edit-form').forEach((form) => {
    const row = form.closest('.edit-row')!;
    form.querySelector<HTMLButtonElement>('.edit-cancel-btn')!.addEventListener('click', () => {
      form.reset();
      form.querySelector<HTMLParagraphElement>('.edit-status')!.textContent = '';
      setEditing(row, false);
    });
  });

  document.querySelectorAll<HTMLFormElement>('.course-edit-form').forEach((form) => {
    const saveBtn = form.querySelector<HTMLButtonElement>('.edit-save-btn')!;
    const statusEl = form.querySelector<HTMLParagraphElement>('.edit-status')!;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      saveBtn.disabled = true;
      statusEl.textContent = '';
      try {
        const formData = new FormData(form);
        const res = await fetch(`/api/admin/courses/${form.dataset.courseId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title: formData.get('title'),
            description: formData.get('description'),
            category: formData.get('category'),
          }),
        });
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.error || '保存に失敗しました');
        }
        window.location.reload();
      } catch (error) {
        statusEl.textContent = error instanceof Error ? error.message : '保存に失敗しました';
        saveBtn.disabled = false;
      }
    });
  });

  document.querySelectorAll<HTMLFormElement>('.lesson-edit-form').forEach((form) => {
    const saveBtn = form.querySelector<HTMLButtonElement>('.edit-save-btn')!;
    const statusEl = form.querySelector<HTMLParagraphElement>('.edit-status')!;
    const lessonUrl = `/api/admin/courses/${form.dataset.courseId}/lessons/${form.dataset.lessonId}`;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      saveBtn.disabled = true;
      statusEl.textContent = '';
      try {
        const formData = new FormData(form);

        const video = formData.get('video') as File | null;
        if (video && video.size > 0) {
          if (!confirm('動画を差し替えます。元の動画は上書きされます。よろしいですか?')) {
            saveBtn.disabled = false;
            return;
          }
          statusEl.textContent = 'アップロードURLを発行中...';
          const urlRes = await fetch(lessonUrl, { method: 'POST' });
          if (!urlRes.ok) throw new Error('アップロードURLの発行に失敗しました');
          const { uploadUrl } = await urlRes.json();

          statusEl.textContent = '動画をアップロード中...';
          const uploadRes = await fetch(uploadUrl, {
            method: 'PUT',
            headers: { 'Content-Type': 'video/mp4' },
            body: video,
          });
          if (!uploadRes.ok) throw new Error('動画のアップロードに失敗しました');
        }

        statusEl.textContent = '保存中...';
        const res = await fetch(lessonUrl, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            chapterTitle: formData.get('chapterTitle'),
            title: formData.get('title'),
            description: formData.get('description'),
          }),
        });
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.error || '保存に失敗しました');
        }
        window.location.reload();
      } catch (error) {
        statusEl.textContent = error instanceof Error ? error.message : '保存に失敗しました';
        saveBtn.disabled = false;
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.delete-course-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.deleteCourse!;
      const title = btn.dataset.deleteTitle;
      if (!confirm(`講座「${title}」をレッスンごと削除します。よろしいですか?`)) return;

      btn.disabled = true;
      try {
        const res = await fetch(`/api/admin/courses/${id}`, { method: 'DELETE' });
        if (!res.ok) throw new Error('削除に失敗しました');
        window.location.reload();
      } catch (error) {
        alert(error instanceof Error ? error.message : '削除に失敗しました');
        btn.disabled = false;
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.delete-lesson-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const courseId = btn.dataset.courseId!;
      const lessonId = btn.dataset.deleteLesson!;
      if (!confirm('このレッスンを削除します。よろしいですか?')) return;

      btn.disabled = true;
      try {
        const res = await fetch(`/api/admin/courses/${courseId}/lessons/${lessonId}`, { method: 'DELETE' });
        if (!res.ok) throw new Error('削除に失敗しました');
        window.location.reload();
      } catch (error) {
        alert(error instanceof Error ? error.message : '削除に失敗しました');
        btn.disabled = false;
      }
    });
  });

  document.querySelectorAll<HTMLFormElement>('.lesson-form').forEach((form) => {
    const courseId = form.dataset.courseId!;
    const submitBtn = form.querySelector<HTMLButtonElement>('.lesson-submit-btn')!;
    const statusEl = form.querySelector<HTMLParagraphElement>('.lesson-status')!;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      submitBtn.disabled = true;
      statusEl.textContent = '';

      try {
        const formData = new FormData(form);
        const file = formData.get('video') as File;
        if (!file || file.size === 0) {
          throw new Error('動画ファイルを選択してください');
        }

        // アップロードが完全に終わるまでFirestoreにレッスンを作らない。
        // 逆順にすると、動画のないレッスンが一瞬会員に見えてしまう。
        statusEl.textContent = 'アップロードURLを発行中...';
        const uploadUrlRes = await fetch(`/api/admin/courses/${courseId}/lessons/upload-url`, {
          method: 'POST',
        });
        if (!uploadUrlRes.ok) {
          throw new Error('アップロードURLの発行に失敗しました');
        }
        const { lessonId, uploadUrl } = await uploadUrlRes.json();

        statusEl.textContent = '動画をアップロード中...';
        const uploadRes = await fetch(uploadUrl, {
          method: 'PUT',
          headers: { 'Content-Type': 'video/mp4' },
          body: file,
        });
        if (!uploadRes.ok) {
          throw new Error('動画のアップロードに失敗しました');
        }

        statusEl.textContent = 'レッスンを作成中...';
        const createRes = await fetch(`/api/admin/courses/${courseId}/lessons/create`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            lessonId,
            title: formData.get('title'),
            description: formData.get('description'),
            chapterTitle: formData.get('chapterTitle'),
          }),
        });
        if (!createRes.ok) {
          const err = await createRes.json().catch(() => ({}));
          throw new Error(err.error || '追加に失敗しました');
        }

        window.location.reload();
      } catch (error) {
        statusEl.textContent = error instanceof Error ? error.message : '予期せぬエラーが発生しました';
        submitBtn.disabled = false;
      }
    });
  });
</script>
