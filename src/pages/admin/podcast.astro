---
import Layout from '../../layouts/Layout.astro';
import { requireAdmin } from '../../lib/admin';
import { adminDb } from '../../lib/firebase/server';

const admin = await requireAdmin(Astro.cookies);
if (!admin) {
  return Astro.redirect('/');
}

const snapshot = await adminDb
  .collection('podcastEpisodes')
  .orderBy('publishedAt', 'desc')
  .get();

const episodes = snapshot.docs.map((doc) => {
  const data = doc.data();
  return {
    id: doc.id,
    title: data.title as string,
    subtitle: (data.subtitle as string) ?? '',
    durationSeconds: data.durationSeconds as number,
    publishedAt: data.publishedAt?.toDate?.() ?? null,
  };
});
---

<Layout title="Podcast管理 - taro." description="Podcastエピソードのアップロード(管理者専用)">
  <main class="min-h-screen bg-black text-white p-8 pt-24 max-w-2xl mx-auto">
    <h1 class="text-2xl md:text-4xl font-black tracking-tight mb-10">Podcast管理</h1>

    <form id="upload-form" class="p-6 rounded-2xl bg-zinc-950 border border-white/10 shadow-xl space-y-5">
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-zinc-500 mb-2">タイトル</label>
        <input name="title" type="text" required
          class="w-full px-4 py-3 rounded-md bg-black border border-white/10 text-white text-sm focus:outline-none focus:border-white/30" />
      </div>

      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-zinc-500 mb-2">概要(一覧に表示される一言)</label>
        <input name="subtitle" type="text"
          class="w-full px-4 py-3 rounded-md bg-black border border-white/10 text-white text-sm focus:outline-none focus:border-white/30" />
      </div>

      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-zinc-500 mb-2">音声ファイル(m4a / mp3)</label>
        <input name="audio" type="file" accept="audio/*" required
          class="w-full text-sm text-zinc-300 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:bg-white/10 file:text-white file:text-xs file:font-bold file:uppercase file:tracking-wider" />
        <p class="text-xs text-zinc-500 mt-2">再生時間はファイルから自動で読み取ります。</p>
      </div>

      <button type="submit" id="submit-btn"
        class="w-full py-3 px-4 bg-white text-black font-bold text-sm tracking-wide rounded-md hover:bg-zinc-200 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
        アップロード
      </button>

      <p id="status" class="text-sm text-center min-h-[1.25rem]"></p>
    </form>

    <h2 class="text-lg font-bold mt-14 mb-5 text-white">配信済みエピソード</h2>
    <div class="space-y-3">
      {episodes.length === 0 && (
        <p class="text-sm text-zinc-500">まだありません。</p>
      )}
      {episodes.map((ep) => (
        <div class="p-4 rounded-xl bg-zinc-950 border border-white/10 flex items-start justify-between gap-4">
          <div class="min-w-0">
            <p class="text-xs text-zinc-500 mb-1">
              {ep.publishedAt ? ep.publishedAt.toLocaleDateString('ja-JP') : '-'} ・ {Math.round(ep.durationSeconds / 60)}分
            </p>
            <p class="font-bold text-sm">{ep.title}</p>
            {ep.subtitle && <p class="text-xs text-zinc-400 mt-1">{ep.subtitle}</p>}
          </div>
          <button
            data-delete-id={ep.id}
            data-delete-title={ep.title}
            class="delete-btn shrink-0 px-3 py-1.5 rounded-md bg-red-500/10 hover:bg-red-500/20 text-red-400 text-xs font-bold transition-colors"
          >
            削除
          </button>
        </div>
      ))}
    </div>
  </main>
</Layout>

<script>
  const form = document.getElementById('upload-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const statusEl = document.getElementById('status') as HTMLParagraphElement;

  function readAudioDuration(file: File): Promise<number> {
    return new Promise((resolve, reject) => {
      const audio = document.createElement('audio');
      audio.preload = 'metadata';
      audio.onloadedmetadata = () => {
        URL.revokeObjectURL(audio.src);
        resolve(audio.duration);
      };
      audio.onerror = () => reject(new Error('音声ファイルを読み取れませんでした'));
      audio.src = URL.createObjectURL(file);
    });
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    submitBtn.disabled = true;
    statusEl.textContent = '';
    statusEl.classList.remove('text-red-400', 'text-emerald-400');

    try {
      const formData = new FormData(form);
      const title = formData.get('title') as string;
      const subtitle = formData.get('subtitle') as string;
      const file = formData.get('audio') as File;

      if (!file || file.size === 0) {
        throw new Error('音声ファイルを選択してください');
      }

      statusEl.textContent = '音声の長さを確認中...';
      const durationSeconds = await readAudioDuration(file);

      statusEl.textContent = 'エピソードを作成中...';
      const createRes = await fetch('/api/admin/podcast/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, subtitle, durationSeconds }),
      });
      if (!createRes.ok) {
        const err = await createRes.json().catch(() => ({}));
        throw new Error(err.error || 'エピソードの作成に失敗しました');
      }
      const { uploadUrl } = await createRes.json();

      statusEl.textContent = '音声をアップロード中...';
      const uploadRes = await fetch(uploadUrl, {
        method: 'PUT',
        headers: { 'Content-Type': 'audio/mp4' },
        body: file,
      });
      if (!uploadRes.ok) {
        throw new Error('音声のアップロードに失敗しました');
      }

      statusEl.textContent = '公開しました。';
      statusEl.classList.add('text-emerald-400');
      setTimeout(() => window.location.reload(), 800);
    } catch (error) {
      statusEl.textContent = error instanceof Error ? error.message : '予期せぬエラーが発生しました';
      statusEl.classList.add('text-red-400');
      submitBtn.disabled = false;
    }
  });

  document.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.deleteId!;
      const title = btn.dataset.deleteTitle;
      if (!confirm(`「${title}」を削除します。よろしいですか?`)) return;

      btn.disabled = true;
      try {
        const res = await fetch(`/api/admin/podcast/${id}`, { method: 'DELETE' });
        if (!res.ok) throw new Error('削除に失敗しました');
        window.location.reload();
      } catch (error) {
        alert(error instanceof Error ? error.message : '削除に失敗しました');
        btn.disabled = false;
      }
    });
  });
</script>
