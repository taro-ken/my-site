---
import Layout from '../layouts/Layout.astro';

const { isLoggedIn, isPremium, user } = Astro.locals;

// Redirect strictly unauthorized users
if (!isLoggedIn || !user) {
  return Astro.redirect("/membership");
}

let stripeStatus = isPremium ? 'active' : 'free';

// Non-subscribers cannot access dashboard
if (!isPremium) {
  console.log(`[dashboard.astro] user is not premium, redirecting to /`);
  return Astro.redirect("/");
}
---

<Layout title="Dashboard - taro.">
  <main class="min-h-screen bg-black text-white p-8 pt-24 max-w-4xl mx-auto">
    <div class="flex flex-row justify-between items-center gap-4 mb-10">
      <h1 class="text-2xl md:text-4xl font-black tracking-tight">
        ダッシュボード
      </h1>
      <button id="signout-btn" class="shrink-0 whitespace-nowrap px-4 md:px-5 py-2 md:py-2.5 rounded-md bg-white/5 hover:bg-white/10 border border-white/10 text-zinc-300 hover:text-white transition-all text-xs md:text-sm font-medium">
        ログアウト
      </button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- プロフィールカード -->
      <div class="p-6 rounded-2xl bg-zinc-950 border border-white/10 shadow-xl">
        <h2 class="text-lg font-bold mb-5 text-white">プロフィール</h2>
        <div class="space-y-4">
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-zinc-500 mb-1">メールアドレス</p>
            <p class="font-medium text-sm">{user.email}</p>
          </div>
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-zinc-500 mb-1">ユーザーID</p>
            <p class="font-medium text-xs font-mono truncate text-zinc-400">{user.uid}</p>
          </div>
        </div>
      </div>

      <!-- サブスクリプションカード -->
      <div class="p-6 rounded-2xl bg-zinc-950 border border-white/10 shadow-xl relative overflow-hidden">
        <div class="absolute top-4 right-4">
          <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold border ${stripeStatus === 'active' ? 'bg-white text-black border-white' : 'bg-zinc-800 text-zinc-400 border-zinc-700'}`}>
            {stripeStatus === 'active' ? 'プレミアム' : '無料プラン'}
          </span>
        </div>
        <h2 class="text-lg font-bold mb-5 text-white">サブスクリプション</h2>
        
        {stripeStatus === 'active' ? (
          <>
            <p class="text-zinc-400 mb-2 text-sm">
              すべてのプレミアム記事・チュートリアル・限定コンテンツにアクセスできます。
            </p>
            <p class="text-zinc-300 mb-6 text-sm font-medium">ご支援いただきありがとうございます。</p>
            <div class="flex flex-col gap-3">
              <form method="POST" action="/api/stripe/portal">
                <button type="submit" class="w-full px-5 py-3 bg-white text-black hover:bg-zinc-200 font-bold rounded-md transition-colors text-sm">
                  サブスクリプションを管理・解約する
                </button>
              </form>
            </div>
          </>
        ) : (
          <>
            <p class="text-zinc-400 mb-6 text-sm">
              プレミアムプランにアップグレードして、限定記事やコンテンツにアクセスしましょう。
            </p>
            <a href="/membership" class="inline-block w-full text-center px-5 py-3 bg-white text-black hover:bg-zinc-200 font-bold rounded-md transition-colors text-sm">
              プランをアップグレード
            </a>
          </>
        )}
      </div>
    </div>

    {stripeStatus === 'active' && (
      <div class="mt-6 p-6 md:p-8 rounded-2xl bg-zinc-950 border border-[#94C843]/30 shadow-xl relative overflow-hidden group">
        <div class="absolute top-0 left-0 w-1 h-full bg-[#94C843]"></div>
        <h2 class="text-xl font-black mb-2 text-white tracking-tight">プレミアムメンバー特典</h2>
        <p class="text-zinc-400 text-sm mb-6">限定コミュニティへの参加や、個別の相談セッションをご利用いただけます。</p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Discord -->
          <!-- TODO: href="#" をDiscordの招待URLに変更してください -->
          <a href="#" target="_blank" rel="noopener noreferrer" class="flex items-center p-4 rounded-xl border border-white/5 bg-white/5 hover:bg-white/10 hover:border-white/20 transition-all group/link">
            <div class="w-10 h-10 rounded-full bg-[#5865F2]/20 flex items-center justify-center mr-4 text-[#5865F2] group-hover/link:scale-110 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/></svg>
            </div>
            <div>
              <p class="font-bold text-white text-sm mb-0.5">Discordコミュニティ</p>
              <p class="text-[11px] text-zinc-400">限定チャンネルに参加する</p>
            </div>
          </a>

          <!-- Form Session -->
          <!-- TODO: href="#" をGoogleフォームやCalendlyのカレンダーURL等に変更してください -->
          <a href="#" target="_blank" rel="noopener noreferrer" class="flex items-center p-4 rounded-xl border border-white/5 bg-white/5 hover:bg-white/10 hover:border-white/20 transition-all group/link">
            <div class="w-10 h-10 rounded-full bg-[#94C843]/20 flex items-center justify-center mr-4 text-[#94C843] group-hover/link:scale-110 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            </div>
            <div>
              <p class="font-bold text-white text-sm mb-0.5">月1回 30分無料セッション</p>
              <p class="text-[11px] text-zinc-400">フォームへ進む</p>
            </div>
          </a>
        </div>
      </div>
    )}
  </main>
</Layout>

<script is:inline src="https://www.gstatic.com/firebasejs/11.4.0/firebase-app-compat.js"></script>
<script is:inline src="https://www.gstatic.com/firebasejs/11.4.0/firebase-auth-compat.js"></script>
<script is:inline>
  function initDashboard() {
    const btn = document.getElementById('signout-btn');
    if (!btn || btn.dataset.initialized) return;
    btn.dataset.initialized = "true";

    const firebaseConfig = {
      apiKey: "AIzaSyDgGGWqX9c4dw_gSSgKkNySWquQBSzQXQM",
      authDomain: "fitw-prod.firebaseapp.com",
      projectId: "fitw-prod",
      storageBucket: "fitw-prod.firebasestorage.app",
      messagingSenderId: "208896639763",
      appId: "1:208896639763:web:dbdbf3a44a7010da6450e6"
    };

    if (typeof firebase !== 'undefined' && !firebase.apps.length) {
      firebase.initializeApp(firebaseConfig);
    }

    btn.addEventListener('click', async function() {
      await firebase.auth().signOut();
      window.location.assign('/api/auth/signout');
    });
  }

  // Initialize dashboard logic
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDashboard);
  } else {
    initDashboard();
  }
</script>
