---
import Layout from '../layouts/Layout.astro';
import BackToHome from '../components/BackToHome.astro';

const { isLoggedIn, isPremium, user } = Astro.locals;

// Redirect strictly unauthorized users
if (!isLoggedIn || !user) {
  return Astro.redirect("/login");
}

// App Store公開後にIDを入れると、リンクが有効になる(未設定の間は「近日公開」の表示)。
const APP_STORE_URL = '';

const firebasePublicConfig = {
  apiKey: import.meta.env.PUBLIC_FIREBASE_API_KEY,
  authDomain: import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN,
  projectId: import.meta.env.PUBLIC_FIREBASE_PROJECT_ID,
  storageBucket: import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET,
  messagingSenderId: import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID,
  appId: import.meta.env.PUBLIC_FIREBASE_APP_ID,
};
---

<Layout title="Dashboard - taro.">
  <main class="min-h-screen bg-black text-white p-8 pt-10 max-w-4xl mx-auto">
    <BackToHome />
    <div class="mt-8 flex flex-row justify-between items-center gap-4 mb-10">
      <h1 class="text-2xl md:text-4xl font-black tracking-tight">
        ダッシュボード
      </h1>
      <button id="signout-btn" class="shrink-0 whitespace-nowrap px-4 md:px-5 py-2 md:py-2.5 rounded-md bg-white/5 hover:bg-white/10 border border-white/10 text-zinc-300 hover:text-white transition-all text-xs md:text-sm font-medium">
        ログアウト
      </button>
    </div>

    <!-- プロフィールカード -->
    <div class="max-w-md p-6 rounded-2xl bg-zinc-950 border border-white/10 shadow-xl">
      <h2 class="text-lg font-bold mb-5 text-white">プロフィール</h2>
      <div class="space-y-4">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-zinc-500 mb-1">メールアドレス</p>
          <p class="font-medium text-sm">{user.email}</p>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-zinc-500 mb-1">ユーザーID</p>
          <p class="font-medium text-xs font-mono truncate text-zinc-400">{user.uid}</p>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-zinc-500 mb-1">ステータス</p>
          {isPremium ? (
            <span class="inline-block px-2.5 py-1 rounded-full bg-emerald-500/15 text-emerald-400 text-xs font-bold">Essenceメンバー</span>
          ) : (
            <span class="inline-block px-2.5 py-1 rounded-full bg-white/10 text-zinc-400 text-xs font-bold">非会員</span>
          )}
        </div>
      </div>
    </div>

    {!isPremium && (
      <div class="max-w-md mt-4">
        <a href="/api/stripe/checkout" class="block text-center px-5 py-3 rounded-xl bg-gradient-to-r from-emerald-400 to-cyan-400 text-black text-sm font-bold hover:brightness-105 transition-all">Essenceに参加する</a>
      </div>
    )}

    <div class="max-w-md mt-4 flex flex-col gap-3">
      {APP_STORE_URL ? (
        <a href={APP_STORE_URL} class="text-center px-5 py-3 rounded-xl bg-white text-black text-sm font-bold hover:bg-zinc-200 transition-colors">App Storeで開く</a>
      ) : (
        <span class="text-center px-5 py-3 rounded-xl bg-white/5 border border-white/10 text-zinc-500 text-sm font-bold">App Storeで近日公開</span>
      )}
      <a href="com.kk.essence://" class="text-center px-5 py-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-zinc-300 hover:text-white transition-all text-sm font-medium">アプリへ戻る</a>
    </div>
  </main>
</Layout>

<script is:inline src="https://www.gstatic.com/firebasejs/11.4.0/firebase-app-compat.js"></script>
<script is:inline src="https://www.gstatic.com/firebasejs/11.4.0/firebase-auth-compat.js"></script>
<script is:inline define:vars={{ firebasePublicConfig }}>
  function initDashboard() {
    const btn = document.getElementById('signout-btn');
    if (!btn || btn.dataset.initialized) return;
    if (document.documentElement.classList.contains('app-embed')) return;
    btn.dataset.initialized = "true";

    const firebaseConfig = firebasePublicConfig;

    if (typeof firebase !== 'undefined' && !firebase.apps.length) {
      firebase.initializeApp(firebaseConfig);
    }

    btn.addEventListener('click', async function(event) {
      event.preventDefault();

      try {
        if (typeof firebase !== 'undefined' && firebase.auth) {
          await firebase.auth().signOut();
        }
      } catch (error) {
        // App WebView では Firebase セッションが無い場合がある
      }

      window.location.assign('/api/auth/signout');
    });
  }

  // Initialize dashboard logic
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDashboard);
  } else {
    initDashboard();
  }
</script>
