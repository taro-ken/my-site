---
import Layout from '../../layouts/Layout.astro';
import { getAllBlogs, FILTER_INCLUDE_GEARLIST, type BlogItem } from '../../lib/cms';

/** ミドルウェアと同じ判定（セッション検証は middleware で一元化） */
const { isPremium } = Astro.locals;

if (!isPremium) {
  const returnPath = Astro.url.pathname + Astro.url.search;
  return Astro.redirect(`/membership?redirect=${encodeURIComponent(returnPath)}`);
}

let gearBlogs: BlogItem[] = [];
try {
  const res = await getAllBlogs({
    filters: FILTER_INCLUDE_GEARLIST,
    orders: '-publishedAt',
  });
  gearBlogs = res.contents.filter((b) => b.gearlist === true);
} catch (e) {
  console.error('Gear review list fetch failed:', e);
}

/** ブログ詳細と同様に [[more]] を除去して全文表示（メンバー閲覧ページのため） */
const PAYWALL_REGEX = /<p>\s*\[\[more\]\]\s*<\/p>|\[\[more\]\]/g;
function fullArticleHtml(raw: string) {
  return raw.split(PAYWALL_REGEX).join('');
}

const proseClasses =
  'prose prose-invert prose-base max-w-none prose-p:text-zinc-100 prose-p:leading-[1.8] prose-p:mb-6 prose-headings:text-white prose-headings:font-black prose-headings:tracking-tight prose-h2:text-xl prose-h2:mt-12 prose-h2:mb-6 prose-h2:pb-2 prose-h2:border-b prose-h2:border-accent prose-h3:text-lg prose-h3:mt-10 prose-h3:mb-4 prose-h3:pl-4 prose-h3:border-l-4 prose-h3:border-zinc-800 prose-a:text-zinc-400 prose-a:underline prose-a:underline-offset-4 prose-a:decoration-zinc-700 hover:prose-a:text-white hover:prose-a:decoration-white prose-strong:text-white prose-ul:text-zinc-100 prose-ol:text-zinc-100 prose-li:marker:text-zinc-500 prose-blockquote:border-l-2 prose-blockquote:border-zinc-600 prose-blockquote:pl-6 prose-blockquote:italic prose-blockquote:font-light prose-blockquote:text-zinc-300 prose-img:rounded-[4px]';
---

<Layout
  title="Full Gear Review - taro."
  description="メンバー限定のギアレビュー。"
>
  <main class="min-h-screen bg-black text-white pt-32 pb-32 px-5 font-sans selection:bg-[#BF953F] selection:text-black">
    <div class="max-w-3xl mx-auto w-full">
      <div class="text-center mb-16 flex flex-col items-center">
        <p class="text-zinc-400 tracking-[0.3em] text-[10px] md:text-xs uppercase mb-4 font-bold">The Gear</p>
        <h1 class="text-4xl md:text-5xl font-black tracking-tight mb-10">
          Full Gear Review
        </h1>
        <a
          href="/all-item-list"
          class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-[0.15em] text-zinc-400 hover:text-white transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m15 18-6-6 6-6"/>
          </svg>
          All Item List に戻る
        </a>
      </div>

      {gearBlogs.length > 0 && (
        <div class="flex flex-col gap-20 md:gap-24">
          {gearBlogs.map((blog) => (
            <article class="text-left">
              {blog.eyecatch && (
                <figure class="mb-10 md:mb-12">
                  <img
                    src={`${blog.eyecatch.url}?w=1200&q=85&fmt=webp`}
                    alt={blog.title}
                    class="w-full h-auto object-cover rounded-[4px]"
                    loading="lazy"
                  />
                </figure>
              )}
              <div class={proseClasses} set:html={fullArticleHtml(blog.content)} />
            </article>
          ))}
        </div>
      )}
    </div>
  </main>
</Layout>

<style is:global>
  .prose blockquote p::before,
  .prose blockquote p::after {
    content: none !important;
  }
</style>
