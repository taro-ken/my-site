---
import Layout from '../../layouts/Layout.astro';
import { getAllBlogs, FILTER_INCLUDE_GEARLIST, type BlogItem } from '../../lib/cms';

/** ミドルウェアと同じ判定（セッション検証は middleware で一元化） */
const { isPremium } = Astro.locals;

if (!isPremium) {
  const returnPath = Astro.url.pathname + Astro.url.search;
  return Astro.redirect(`/membership?redirect=${encodeURIComponent(returnPath)}`);
}

let gearBlogs: BlogItem[] = [];
try {
  const res = await getAllBlogs({
    filters: FILTER_INCLUDE_GEARLIST,
    orders: '-publishedAt',
  });
  gearBlogs = res.contents.filter((b) => b.gearlist === true);
} catch (e) {
  console.error('Gear review list fetch failed:', e);
}

const stripHtml = (html: string) => html.replace(/<[^>]*>?/gm, '');
---

<Layout
  title="Full Gear Review - taro."
  description="メンバー限定のギアレビュー。"
>
  <main class="min-h-screen bg-black text-white pt-32 pb-32 px-5 font-sans selection:bg-[#BF953F] selection:text-black">
    <div class="max-w-3xl mx-auto w-full">
      <div class="text-center mb-16 flex flex-col items-center">
        <p class="text-zinc-400 tracking-[0.3em] text-[10px] md:text-xs uppercase mb-4 font-bold">The Gear</p>
        <h1 class="text-4xl md:text-5xl font-black tracking-tight mb-10">
          Full Gear Review
        </h1>
        <a
          href="/all-item-list"
          class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-[0.15em] text-zinc-400 hover:text-white transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m15 18-6-6 6-6"/>
          </svg>
          All Item List に戻る
        </a>
      </div>

      {gearBlogs.length > 0 && (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8">
          {gearBlogs.map((blog) => (
            <article class="flex flex-col group">
              <a href={`/gear-review/${blog.id}`} class="block mb-4 overflow-hidden bg-zinc-900 aspect-[16/10] relative rounded-[4px]">
                {blog.eyecatch ? (
                  <img
                    src={`${blog.eyecatch.url}?w=600&q=80&fmt=webp`}
                    alt={blog.title}
                    class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-zinc-600">
                    <span class="tracking-widest uppercase text-[10px]">No Image</span>
                  </div>
                )}
              </a>
              <a href={`/gear-review/${blog.id}`} class="flex flex-col flex-1">
                <h2 class="text-lg font-bold mb-2 leading-snug group-hover:text-zinc-300 transition-colors line-clamp-3">
                  {blog.title}
                </h2>
                <p class="text-zinc-500 text-xs md:text-sm leading-relaxed line-clamp-3">
                  {stripHtml(blog.content).slice(0, 120)}
                  {stripHtml(blog.content).length > 120 ? '…' : ''}
                </p>
              </a>
            </article>
          ))}
        </div>
      )}
    </div>
  </main>
</Layout>
