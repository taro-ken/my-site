---
import Layout from '../layouts/Layout.astro';
import BackToHome from '../components/BackToHome.astro';

const firebasePublicConfig = {
  apiKey: import.meta.env.PUBLIC_FIREBASE_API_KEY,
  authDomain: import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN,
  projectId: import.meta.env.PUBLIC_FIREBASE_PROJECT_ID,
  storageBucket: import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET,
  messagingSenderId: import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID,
  appId: import.meta.env.PUBLIC_FIREBASE_APP_ID,
};
---

<Layout title="パスワードをお忘れの方 | Taro Essence">
  <main class="min-h-screen bg-black text-white flex items-center justify-center p-4 relative overflow-hidden font-sans selection:bg-white selection:text-black">
    <div class="absolute top-6 left-6"><BackToHome /></div>
    <div class="max-w-md w-full rounded-2xl p-8 sm:p-10 shadow-2xl bg-zinc-950 border border-white/10">

      <div id="state-form">
        <div class="text-center mb-8">
          <h1 class="text-3xl font-black mb-3 tracking-tight">パスワードの再設定</h1>
          <p class="text-zinc-400 text-sm font-medium">登録したメールアドレスに、再設定用のリンクをお送りします。</p>
        </div>

        <div id="error-msg" class="mb-4 p-3 rounded-md text-sm bg-red-950/50 text-red-500 border border-red-900/50 text-center font-medium hidden"></div>

        <div class="space-y-5">
          <div>
            <label for="email" class="block text-xs font-bold uppercase tracking-wider text-zinc-400 mb-2">メールアドレス</label>
            <input
              type="email"
              id="email"
              required
              placeholder="you@example.com"
              class="w-full px-4 py-3 rounded-md bg-black border border-white/10 text-white placeholder-zinc-600 focus:outline-none focus:border-white transition-colors text-sm"
            />
          </div>

          <button
            id="submit-btn"
            type="button"
            class="w-full py-4 px-4 mt-4 bg-white hover:bg-zinc-200 text-black font-black text-xs tracking-[0.1em] uppercase rounded-sm shadow-lg transition-colors"
          >
            再設定メールを送る
          </button>
        </div>
      </div>

      <div id="state-sent" class="text-center py-6 hidden">
        <h1 class="text-2xl font-black mb-3 tracking-tight">メールを送信しました</h1>
        <p class="text-zinc-400 text-sm font-medium">
          <span id="sent-email" class="text-white"></span> 宛に再設定用のリンクをお送りしました。メール内のリンクから新しいパスワードを設定してください。<br /><br />
          届かない場合は、迷惑メールフォルダもご確認ください。
        </p>
      </div>

      <p class="mt-8 text-center text-sm font-medium text-zinc-500">
        <a href="/login" class="text-white hover:underline underline-offset-4 transition-all">ログイン画面に戻る</a>
      </p>
    </div>
  </main>
</Layout>

<!-- Load Firebase SDK from CDN using is:inline to bypass Astro module bundling entirely -->
<script is:inline src="https://www.gstatic.com/firebasejs/11.4.0/firebase-app-compat.js"></script>
<script is:inline src="https://www.gstatic.com/firebasejs/11.4.0/firebase-auth-compat.js"></script>
<script is:inline define:vars={{ firebasePublicConfig }}>
  function initForgotPassword() {
    const btn = document.getElementById('submit-btn');
    if (!btn || btn.dataset.initialized) return;
    btn.dataset.initialized = "true";

    if (typeof firebase !== 'undefined' && !firebase.apps.length) {
      firebase.initializeApp(firebasePublicConfig);
    }

    const emailInput = document.getElementById('email');
    const errorMsg = document.getElementById('error-msg');

    const prefill = new URLSearchParams(window.location.search).get('email');
    if (prefill) emailInput.value = prefill;

    function showSent(email) {
      document.getElementById('sent-email').textContent = email;
      document.getElementById('state-form').classList.add('hidden');
      document.getElementById('state-sent').classList.remove('hidden');
    }

    btn.addEventListener('click', async function () {
      const email = emailInput.value.trim();
      errorMsg.classList.add('hidden');

      if (!email) {
        errorMsg.textContent = 'メールアドレスを入力してください。';
        errorMsg.classList.remove('hidden');
        return;
      }

      btn.textContent = '送信中...';
      btn.disabled = true;

      try {
        firebase.auth().languageCode = 'ja';
        await firebase.auth().sendPasswordResetEmail(email);
        showSent(email);
      } catch (error) {
        const code = error.code || '';
        // 登録の有無を外部から判別できないよう、未登録でも送信完了と同じ表示にする
        if (code === 'auth/user-not-found') {
          showSent(email);
          return;
        }
        if (code === 'auth/invalid-email') {
          errorMsg.textContent = 'メールアドレスの形式が正しくありません。';
        } else if (code === 'auth/too-many-requests') {
          errorMsg.textContent = '送信回数が多すぎます。しばらくしてから再度お試しください。';
        } else {
          errorMsg.textContent = 'エラーが発生しました。もう一度お試しください。';
        }
        errorMsg.classList.remove('hidden');
        btn.textContent = '再設定メールを送る';
        btn.disabled = false;
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initForgotPassword);
  } else {
    initForgotPassword();
  }
</script>
