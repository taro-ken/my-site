---
import Layout from '../../layouts/Layout.astro';
import { getBlogDetail, getBlogs, type BlogItem } from '../../lib/cms';
import { adminAuth, adminDb } from '../../lib/firebase/server';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

let blog: BlogItem | null = null;
let prevPost: BlogItem | null = null;
let nextPost: BlogItem | null = null;

try {
  blog = await getBlogDetail(slug);
  
  // Fetch Next/Prev posts
  const [prevResponse, nextResponse] = await Promise.all([
    getBlogs({ 
      filters: `publishedAt[less_than]${blog.publishedAt}`, 
      orders: '-publishedAt', 
      limit: 1 
    }),
    getBlogs({ 
      filters: `publishedAt[greater_than]${blog.publishedAt}`, 
      orders: 'publishedAt', 
      limit: 1 
    })
  ]);
  
  prevPost = prevResponse.contents[0] || null;
  nextPost = nextResponse.contents[0] || null;
} catch (error) {
  console.error(error);
  return Astro.redirect('/404');
}

// Access Control Logic
let hasAccess = true;
let isSubscribed = false;
let isLoggedIn = false;

if (blog.is_premium) {
  hasAccess = false; // Default to locked
  
  const sessionCookie = Astro.cookies.get("session")?.value;

  if (sessionCookie) {
    try {
      const decodedToken = await adminAuth.verifySessionCookie(sessionCookie, true);
      isLoggedIn = true;
      
      // Check subscription status in Firestore
      const doc = await adminDb.collection('users').doc(decodedToken.uid).get();
      if (doc.exists && doc.data()?.stripe_status === 'active') {
        hasAccess = true;
        isSubscribed = true;
      }
    } catch (err) {
      // Invalid token or error fetching user, keep access locked
    }
  }
}
// Helper to strip HTML and get excerpt
const getExcerpt = (html: string) => {
  const text = html.replace(/<[^>]*>?/gm, '');
  return text.length > 160 ? text.slice(0, 157) + "..." : text;
};

const blogDescription = blog ? getExcerpt(blog.content) : "";
---

<Layout 
  title={`${blog.title} | taro.`}
  description={blogDescription}
  ogImage={blog.eyecatch?.url}
  ogType="article"
  canonicalUrl={`https://kentaro.vercel.app/blog/${blog.id}`}
>
  <main class="min-h-screen bg-black text-zinc-200 font-sans pt-32 pb-32 selection:bg-white selection:text-black">
    
    <article class="max-w-[460px] mx-auto px-5 md:px-0">
      
      <!-- Top meta -->
      <div class="flex items-center text-sm text-zinc-400 mb-6 gap-3">
        <time datetime={blog.publishedAt}>
          {new Date(blog.publishedAt).toLocaleDateString("en-US", { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <span class="text-zinc-600">|</span>
        <span class="text-zinc-300">taro.</span>
      </div>

      <!-- Title -->
      <h1 class="text-2xl md:text-3xl font-black tracking-tight text-white mb-8 leading-[1.3]">
        {blog.is_premium && !hasAccess && (
          <span class="inline-block align-middle mr-4 -translate-y-1 text-white" title="Locked Premium Content">
            <svg class="w-8 h-8 md:w-10 md:h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
          </span>
        )}
        <span class="align-middle">{blog.title}</span>
      </h1>

      {blog.eyecatch && (
        <figure class="mb-16">
          <img src={blog.eyecatch.url} alt={blog.title} class="w-full h-auto object-cover rounded-[4px]" />
        </figure>
      )}

      <!-- Content Area -->
      <div class="prose prose-invert prose-base max-w-none 
                  prose-p:text-zinc-100 prose-p:leading-[1.8] prose-p:mb-6
                  prose-headings:text-white prose-headings:font-black prose-headings:tracking-tight
                  prose-h2:text-xl prose-h2:mt-10 prose-h2:mb-4
                  prose-h3:text-lg prose-h3:mt-8 prose-h3:mb-3
                  prose-a:text-zinc-400 prose-a:underline prose-a:underline-offset-4 prose-a:decoration-zinc-700 hover:prose-a:text-white hover:prose-a:decoration-white
                  prose-strong:text-white
                  prose-ul:text-zinc-100 prose-ol:text-zinc-100
                  prose-li:marker:text-zinc-500
                  prose-blockquote:border-l-4 prose-blockquote:border-[#BF953F] prose-blockquote:pl-6 prose-blockquote:not-italic prose-blockquote:text-zinc-300">
        
        {hasAccess ? (
          <div set:html={blog.content} />
        ) : (
          <div class="relative">
            <div class="h-[65vh] overflow-hidden relative select-none">
               <div class="absolute inset-0 bg-gradient-to-b from-transparent via-black/80 to-black z-10"></div>
               <div class="opacity-40 blur-[8px] pointer-events-none" set:html={blog.content}></div>
            </div>
            
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full px-4 z-20">
              <div class="max-w-md mx-auto p-[1px] bg-gradient-to-b from-zinc-700 to-zinc-900 rounded-lg shadow-2xl not-prose">
                <div class="bg-black p-8 md:p-12 rounded-lg text-center">
                  <h3 class="text-2xl font-black text-white mb-4 tracking-tight">会員限定コンテンツです</h3>
                  <p class="text-zinc-400 mb-8 text-sm leading-relaxed font-medium">
                    この記事の続きを読んで、毎週配信される人間の可能性、インターネット、未来に関する深い考察を受け取るには、プレミアムメンバーにご登録ください。
                  </p>
                  <a href="/pricing" class="block w-full py-4 px-6 bg-white hover:bg-zinc-200 text-black font-black text-xs tracking-[0.1em] transition-colors rounded-sm no-underline">
                    メンバーに登録する
                  </a>
                  {!isLoggedIn && (
                    <div class="mt-6 pt-6 border-t border-zinc-900">
                      <p class="text-xs text-zinc-500 font-medium tracking-wide">
                        すでに登録済みですか？ <a href="/login" class="text-white hover:underline underline-offset-4 transition-all ml-1">ログインはこちら</a>
                      </p>
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        )}
      </div>

    </article>

    {/* Next/Prev Navigation */}
    <nav class="max-w-[460px] mx-auto px-5 md:px-0 mt-16 pt-8 border-t border-zinc-900 flex justify-between items-center gap-4">
      <div class="flex-1 text-left">
        {prevPost && (
          <a href={`/blog/${prevPost.id}`} class="group flex flex-col gap-2">
            <span class="text-[10px] uppercase tracking-widest text-zinc-500 font-bold group-hover:text-zinc-300 transition-colors">Previous Post</span>
            <span class="text-xs md:text-sm font-bold text-white group-hover:text-zinc-300 transition-colors line-clamp-2">{prevPost.title}</span>
          </a>
        )}
      </div>
      <div class="w-[1px] h-8 bg-zinc-900 mx-2"></div>
      <div class="flex-1 text-right">
        {nextPost && (
          <a href={`/blog/${nextPost.id}`} class="group flex flex-col gap-2 items-end">
            <span class="text-[10px] uppercase tracking-widest text-zinc-500 font-bold group-hover:text-zinc-300 transition-colors">Next Post</span>
            <span class="text-xs md:text-sm font-bold text-white group-hover:text-zinc-300 transition-colors line-clamp-2 text-right">{nextPost.title}</span>
          </a>
        )}
      </div>
    </nav>
  </main>

  {/* Clean Minimalist Footer */}
  <footer class="bg-black text-white py-12 px-6 border-t border-zinc-900">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-end items-start gap-12 w-full">
      <div class="flex flex-col">
        <h4 class="font-bold text-lg mb-2">Gain An Essential Perspective</h4>
        <p class="text-zinc-400 text-sm leading-relaxed mb-4 max-w-sm">
          知の探求を、さらに深く。
        </p>
        <a href="/pricing" class="flex items-center text-sm font-bold text-white hover:text-zinc-400 transition-colors">
          <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
          </svg>
          Join The Essence
        </a>
      </div>
    </div>
    <div class="max-w-6xl mx-auto text-center mt-16 text-xs text-zinc-500 font-medium">
      © All Rights Reserved.
    </div>
  </footer>
</Layout>

<style is:global>
  /* Remove the injected quotation marks from prose blockquotes */
  .prose blockquote p::before,
  .prose blockquote p::after {
    content: none !important;
  }
</style>
