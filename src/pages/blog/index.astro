---
import Layout from '../../layouts/Layout.astro';
import { getBlogs, getCategories, type BlogItem, type Category } from '../../lib/cms';

const url = new URL(Astro.request.url);
const catId = url.searchParams.get('category');

let blogs: BlogItem[] = [];
let categories: Category[] = [];
let errorMsg = null;

try {
  const blogsResponse = await getBlogs(catId ? { filters: `category[equals]${catId}` } : undefined);
  blogs = blogsResponse.contents;
  
  const catsResponse = await getCategories();
  categories = catsResponse.contents;
} catch (error: any) {
  console.error("microCMS fetch error:", error);
  errorMsg = "Unable to fetch content. Please check your configuration.";
}

// Helper to strip HTML for excerpt
const stripHtml = (html: string) => html.replace(/<[^>]*>?/gm, '');
---

<Layout title="Blog | Kimoto Portfolio">
  <main class="min-h-screen bg-black text-white pt-32 pb-24 px-5 font-sans selection:bg-white selection:text-black">
    <div class="max-w-6xl mx-auto">
      
      {/* Header section matching homepage */}
      <div class="text-center mb-12 flex flex-col items-center">
        <p class="text-zinc-400 tracking-[0.3em] text-[10px] md:text-xs uppercase mb-4 font-bold">The Blog</p>
        <h1 class="text-4xl md:text-5xl font-black tracking-tight mb-4">
          Articles & Insights
        </h1>
        <p class="text-zinc-400 font-medium max-w-2xl text-sm md:text-base">
          習慣、思考法、そしてより少ないもので豊かに生きるための実践的な気づき
        </p>
      </div>

      {/* Filter Bar */}
      <div class="flex flex-wrap justify-center gap-3 mb-12">
        <a 
          href="/blog" 
          class={`px-4 py-1.5 rounded-full text-[10px] md:text-xs font-bold tracking-widest uppercase transition-colors border ${!catId ? 'bg-white text-black border-white' : 'text-zinc-500 border-zinc-800 hover:border-zinc-600'}`}
        >
          All
        </a>
        {categories.map((cat) => (
          <a 
            href={`/blog?category=${cat.id}`} 
            class={`px-4 py-1.5 rounded-full text-[10px] md:text-xs font-bold tracking-widest uppercase transition-colors border ${catId === cat.id ? 'bg-white text-black border-white' : 'text-zinc-500 border-zinc-800 hover:border-zinc-600'}`}
          >
            {cat.name}
          </a>
        ))}
      </div>

      {errorMsg && (
        <div class="p-4 mb-8 text-sm text-yellow-200 bg-yellow-900/30 border border-yellow-700/50 rounded-xl max-w-2xl mx-auto text-center">
          <p>{errorMsg}</p>
        </div>
      )}

      {!errorMsg && blogs.length === 0 && (
        <div class="text-center py-20 text-zinc-500 font-medium font-sans">
          <p>記事がありません</p>
        </div>
      )}

      <div class="grid grid-cols-2 lg:grid-cols-3 gap-x-3 gap-y-8 md:gap-x-6 md:gap-y-12">
        {blogs.map((blog) => (
          <article class="flex flex-col group cursor-pointer relative text-left">
            <a href={`/blog/${blog.id}`} class="block mb-4 overflow-hidden bg-zinc-900 aspect-[16/10] relative rounded-[4px]">
              {blog.eyecatch ? (
                <img 
                  src={blog.eyecatch.url} 
                  alt={blog.title} 
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-zinc-600">
                  <span class="tracking-widest uppercase text-[10px]">No Image</span>
                </div>
              )}
            </a>

            <a href={`/blog/${blog.id}`} class="flex flex-col flex-1">
              <h3 class="text-[11px] md:text-lg font-bold mb-2 md:mb-3 leading-[1.4] md:leading-[1.3] group-hover:text-zinc-300 transition-colors line-clamp-3">
                {blog.is_premium && (
                  <span class="inline-block align-middle mr-1.5 -translate-y-0.5 text-white" title="Premium Content">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                    </svg>
                  </span>
                )}
                <span class="align-middle">{blog.title}</span>
              </h3>
              
              <p class="text-[10px] md:text-xs text-zinc-400 mb-3 md:mb-4 leading-relaxed line-clamp-2 italic">
                {stripHtml(blog.content)}
              </p>

              <div class="font-bold underline underline-offset-[3px] decoration-1 mb-3 md:mb-4 text-[9px] md:text-[10px] text-zinc-200 group-hover:text-white transition-colors uppercase tracking-widest">
                Read Full Post
              </div>

              <div class="pt-3 border-t border-zinc-800 text-[9px] md:text-[10px] text-zinc-500 font-semibold flex items-center">
                <span class="italic text-zinc-300">taro.</span>
                <span class="mx-2 uppercase tracking-wider">•</span>
                <span class="uppercase tracking-wider">{new Date(blog.publishedAt).toLocaleDateString("en-US", { year: 'numeric', month: 'long', day: 'numeric' })}</span>
              </div>
            </a>
          </article>
        ))}
      </div>

    </div>
  </main>
</Layout>
