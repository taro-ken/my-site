---
import Header from '../components/Header.astro';
import Project from '../components/Project.astro';
import '../styles/global.css';

export const prerender = true;

const languages = ['Swift', 'Flutter', 'Python'];
const tools = ['Firebase', 'AWS', 'Node.js', 'Shopify'];

const projects = [
  {
    title: "Focusy<br>-タスク完了でロック解放-",
    desc: [
      "集中力を取り戻し、やるべきことをやり切ろう"
    ],
    tech: ["Swift", "Firebase"],
    images: ["/assets/projects/focusy_1.png", "/assets/projects/focusy_2.png"],
    storeUrl: "https://apps.apple.com/jp/app/focusy-%E3%82%BF%E3%82%B9%E3%82%AF%E5%AE%8C%E4%BA%86%E3%81%A7%E3%83%AD%E3%83%83%E3%82%AF%E8%A7%A3%E6%94%BE/id6747918924"
  },
  {
    title: "ボディビルノート<br>- 究極の筋トレ記録管理 -",
    desc: [
      "種目・セット・レポート・PFC・体重を一括管理"
    ],
    tech: ["Swift", "Firebase"],
    images: ["/assets/projects/body_1.png", "/assets/projects/body_2.png"],
    storeUrl: "https://apps.apple.com/app/id6749787325"
  },
  {
    title: "KindPick",
    desc: [
      "読むだけで終わらせない「自分だけの記録を」"
    ],
    tech: ["Swift", "Firebase", "AWS", "Node.js"],
    images: ["/assets/projects/kind_1.png", "/assets/projects/kind_2.png"],
    storeUrl: "https://apps.apple.com/jp/app/kindpick/id6748674016"
  },
  {
    title: "Minimal Journal",
    desc: [
      "手書きで自分だけのジャーナルを"
    ],
    tech: ["Swift"],
    images: ["/assets/projects/journal_1.png", "/assets/projects/journal_2.png"],
    storeUrl: "https://apps.apple.com/jp/app/minimal-journal/id6749220922"
  },
  {
    title: "MyTube<br>-自分だけのプレイリスト作成-",
    desc: [
      "お気に入りの動画を手元に！"
    ],
    tech: ["Swift", "Youtube Data API"],
    image: "/assets/projects/mytube.jpg",
    storeUrl: "https://apps.apple.com/jp/app/mytube-%E8%87%AA%E5%88%86%E3%81%A0%E3%81%91%E3%81%AE%E3%83%97%E3%83%AC%E3%82%A4%E3%83%AA%E3%82%B9%E3%83%88%E4%BD%9C%E6%88%90/id6447217754"
  },
  {
    title: "LEFT DAYS",
    desc: [
      "Googleカレンダー同期可能"
    ],
    tech: ["Swift", "Google Calendar API"],
    image: "/assets/projects/leftdays.jpg",
    storeUrl: "https://apps.apple.com/jp/app/left-days-%E3%81%82%E3%81%A8%E4%BD%95%E6%97%A5/id6504957603"
  },
  {
    title: "dumi jewelry",
    desc: [
      "jewelrybrand website"
    ],
    tech: ["BASE", "HTML/CSS", "JavaScript"],
    images: ["/assets/projects/dumi_1.png", "/assets/projects/dumi_2.png"],
    url: "https://dumi.official.ec/"
  }
];
---

<!DOCTYPE html>
<html
>
  <Header 
    title="Personal Projects | KENTARO" 
    description="個人プロジェクト一覧"
    canonicalUrl="https://kentaro.vercel.app/personal-projects"
  />
  <body>
    <div class="content">
      <nav class="main">
        <div class="container">
          <div class="back-nav-container">
            <a href="/" class="back-nav-button w-inline-block"
              ><img src="/assets/back.svg" loading="lazy" alt="" class="back-nav-img" />
              <div>Back</div></a
            >
          </div>
          <div class="content-container">
            <h1 style="font-size: 1.8rem; margin-bottom: 0.1rem;">Personal Projects</h1>
            
            <!-- Languages Section -->
            <section class="skills-section" style="margin-top: 1rem;">
              <h2 class="section-title">Languages</h2>
              <div class="flex flex-wrap gap-2 mt-0">
                {languages.map((language) => (
                  <span class="skill-chip">{language}</span>
                ))}
              </div>
            </section>
            
            <!-- Tools Section -->
            <section class="skills-section" style="margin-top: -1rem;">
              <h2 class="section-title">Tools</h2>
              <div class="flex flex-wrap gap-2 mt-0">
                {tools.map((tool) => (
                  <span class="skill-chip">{tool}</span>
                ))}
              </div>
            </section>
            
            <section class="items-container">
                <div class="resouce-items">
                    {projects.map(project => (
                      <Project 
                        title={project.title} 
                        desc={project.desc}
                        tech={project.tech}
                        images={project.images}
                        image={project.image}
                        url={project.url}
                        storeUrl={project.storeUrl}
                      />
                    ))}
                  </div>
            </section>
          </div>
        </div>
      </nav>
    </div>

    <!--[if lte IE 9]><script src="//cdnjs.cloudflare.com/ajax/libs/placeholders/3.0.2/placeholders.min.js"></script><![endif]-->
  </body>
</html>

<style>
  .skill-chip {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background-color: #0c0c0c;
    color: #ffffff;
    border-radius: 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
  }
  
  .skills-section {
    margin-bottom: 1rem;
    text-align: left;
    width: 100%;
  }
  
  .skills-section .section-title {
    text-align: left !important;
    margin-bottom: 0.5rem;
    width: 100%;
    margin-left: 0 !important;
  }
  
  .skills-section .flex {
    justify-content: flex-start !important;
    margin-left: 0 !important;
  }
</style>
