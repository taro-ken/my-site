---
import Layout from '../layouts/Layout.astro';
import Project from '../components/Project.astro';


const languages = ['Swift', 'Flutter', 'Python'];
const tools = ['Firebase', 'AWS', 'Node.js', 'Shopify'];

const projects = [
  {
    title: "Focusy<br>-タスク完了でロック解放-",
    desc: [
      "集中力を取り戻し、やるべきことをやり切ろう"
    ],
    tech: ["Swift", "Firebase"],
    images: ["/assets/projects/focusy_1.png", "/assets/projects/focusy_2.png"],
    storeUrl: "https://apps.apple.com/jp/app/focusy-%E3%82%BF%E3%82%B9%E3%82%AF%E5%AE%8C%E4%BA%86%E3%81%A7%E3%83%AD%E3%83%83%E3%82%AF%E8%A7%A3%E6%94%BE/id6747918924"
  },
  {
    title: "ボディビルノート<br>- 究極の筋トレ記録管理 -",
    desc: [
      "種目・セット・レポート・PFC・体重を一括管理"
    ],
    tech: ["Swift", "Firebase"],
    images: ["/assets/projects/body_1.png", "/assets/projects/body_2.png"],
    storeUrl: "https://apps.apple.com/app/id6749787325"
  },
  {
    title: "KindPick",
    desc: [
      "読むだけで終わらせない「自分だけの記録を」"
    ],
    tech: ["Swift", "Firebase", "AWS", "Node.js"],
    images: ["/assets/projects/kind_1.png", "/assets/projects/kind_2.png"],
    storeUrl: "https://apps.apple.com/jp/app/kindpick/id6748674016"
  },
  {
    title: "Minimal Journal",
    desc: [
      "手書きで自分だけのジャーナルを"
    ],
    tech: ["Swift"],
    images: ["/assets/projects/journal_1.png", "/assets/projects/journal_2.png"],
    storeUrl: "https://apps.apple.com/jp/app/minimal-journal/id6749220922"
  },
  {
    title: "MyTube<br>-自分だけのプレイリスト作成-",
    desc: [
      "お気に入りの動画を手元に！"
    ],
    tech: ["Swift", "Youtube Data API"],
    image: "/assets/projects/mytube.jpg",
    storeUrl: "https://apps.apple.com/jp/app/mytube-%E8%87%AA%E5%88%86%E3%81%A0%E3%81%91%E3%81%AE%E3%83%97%E3%83%AC%E3%82%A4%E3%83%AA%E3%82%B9%E3%83%88%E4%BD%9C%E6%88%90/id6447217754"
  },
  {
    title: "LEFT DAYS",
    desc: [
      "Googleカレンダー同期可能"
    ],
    tech: ["Swift", "Google Calendar API"],
    image: "/assets/projects/leftdays.jpg",
    storeUrl: "https://apps.apple.com/jp/app/left-days-%E3%81%82%E3%81%A8%E4%BD%95%E6%97%A5/id6504957603"
  },
  {
    title: "dumi jewelry",
    desc: [
      "jewelrybrand website"
    ],
    tech: ["BASE", "HTML/CSS", "JavaScript"],
    images: ["/assets/projects/dumi_1.png", "/assets/projects/dumi_2.png"],
    url: "https://dumi.official.ec/"
  }
];
---

<Layout 
  title="Personal Projects - taro." 
  description="個人プロジェクト一覧。"
  canonicalUrl="https://kentaro.life/personal-projects"
  hideNav={true}
>
    <main class="content-wrapper min-h-screen pt-24 pb-20">
      <div class="max-w-4xl mx-auto px-6">
        <div class="mb-12">
          <a href="/" class="back-link group">
            <img src="/assets/back.svg" loading="lazy" alt="" class="w-5 h-5 transition-transform group-hover:-translate-x-1" />
            <span class="text-sm font-medium">Back</span>
          </a>
        </div>

        <div class="space-y-16">
          <header>
            <h1 class="text-4xl font-bold tracking-tight mb-8">Personal Projects</h1>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
              <!-- Languages Section -->
              <section>
                <h2 class="text-lg font-semibold mb-4 text-neutral-400">Languages</h2>
                <div class="flex flex-wrap gap-2">
                  {languages.map((language) => (
                    <span class="skill-chip">{language}</span>
                  ))}
                </div>
              </section>
              
              <!-- Tools Section -->
              <section>
                <h2 class="text-lg font-semibold mb-4 text-neutral-400">Tools</h2>
                <div class="flex flex-wrap gap-2">
                  {tools.map((tool) => (
                    <span class="skill-chip">{tool}</span>
                  ))}
                </div>
              </section>
            </div>
          </header>

          <section>
            <div class="flex flex-col gap-12">
              {projects.map(project => (
                <Project 
                  title={project.title} 
                  desc={project.desc}
                  tech={project.tech}
                  images={project.images}
                  image={project.image}
                  url={project.url}
                  storeUrl={project.storeUrl}
                />
              ))}
            </div>
          </section>
        </div>
      </div>
    </main>
  </Layout>

<style>
  .content-wrapper {
    background: radial-gradient(circle at top right, rgba(20, 20, 20, 0.8), transparent 40%),
                radial-gradient(circle at bottom left, rgba(15, 15, 15, 0.8), transparent 40%);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #888;
    text-decoration: none;
    transition: color 0.2s;
  }
  
  .back-link:hover {
    color: #fff;
  }

  .skill-chip {
    display: inline-block;
    padding: 0.4rem 1rem;
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #eee;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .skill-chip:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-1px);
  }
</style>
