---
import Header from "../components/Header.astro";
import { Icon } from 'astro-icon/components';
import '../styles/global.css';

export const prerender = true;

const socialLinks = [
  {
    name: 'YouTube',
    url: 'https://www.youtube.com/channel/UCuEiSkWRxlzYiagZKhTpb2A',
  },
  {
    name: 'Instagram',
    url: 'https://www.instagram.com/kentaro_ntc/',
  },
  {
    name: 'Note',
    url: 'https://note.com/taroken2411',
  },
  {
    name: 'GitHub',
    url: 'https://github.com/taro-ken',
  },
];

const skills = ['Swift', 'Flutter', 'Shopify', 'Node.js', 'AWS'];
---


<!DOCTYPE html>
<html lang="ja">
  <Header 
    title="KENTARO" 
    description="ミニマルに生きるEngineer"
    canonicalUrl="https://kentaro.vercel.app/"
  />
  <body>
    <div class="content">
      <nav class="main">
        <div class="container">
          <!-- Hero Section -->
          <main class="app-container flex flex-col gap-2 pt-12 md:pt-16 pb-0 relative">
            <div class="flex flex-row items-center gap-4">
              <div class="flex-shrink-0">
                <img 
                  src="/assets/profile-icon.jpg" 
                  loading="lazy" 
                  alt="KENTARO" 
                  class="w-16 h-16 md:w-20 md:h-20 rounded-lg object-cover border-2 border-foreground/10"
                />
              </div>
              <div>
                <h1 class="text-xs font-bold leading-none">KENTARO.</h1>
                <p class="text-sm font-light leading-normal">Engineer / Creator</p>
              </div>
            </div>
          </main>

          <!-- About Section -->
          <section class="app-container py-0">
            <h2 class="section-title">About</h2>
            <p class="text-xs max-w-2xl font-light leading-normal">
              東京在住のミニマルに生きるエンジニア。複数の大手企業案件で実務経験を重ね、個人ではiOSアプリを開発。YouTube・Podcastでも発信。
            </p>
          </section>

          <!-- Social Section -->
          <section class="app-container py-0">
            <h2 class="section-title">Social</h2>
            <div class="flex flex-wrap gap-8 mt-0">
              {socialLinks.map((link) => (
                <a
                  class="text-xs text-primary no-underline hover:no-underline"
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {link.name}
                </a>
              ))}
            </div>
          </section>

          <!-- All Item List Section -->
          <section class="app-container py-0">
            <h2 class="section-title">All Item List</h2>
            <p class="text-xs max-w-xl">
              全ての持ち物をリスト化しています。
            </p>
            <a class="btn-secondary" href="/all-item-list">
              View Items
              <Icon size={14} name="mdi:arrow-right" />
            </a>
          </section>

          <!-- Projects & Skills Section -->
          <section class="app-container py-0">
            <h2 class="section-title">Projects & Skills</h2>
            <p class="text-xs max-w-xl">
              Work as an engineer, projects, and skills.
            </p>
            <a class="btn-secondary" href="/personal-projects">
              View Projects
              <Icon size={14} name="mdi:arrow-right" />
            </a>
          </section>

          <!-- Get in touch Section -->
          <section class="app-container py-0">
            <h2 class="section-title">Contact / Services</h2>
            <p class="text-xs max-w-xl">
              お問い合わせやご相談は、以下のリンクからお気軽にご連絡ください。
            </p>
            <div class="flex flex-wrap space-x-4">
              <a
                class="btn-primary"
                href="/contact"
              >
                Contact
                <Icon height={14} name="mdi:email" />
              </a>
              <a class="btn-secondary" href="/services" target="_self">
                Services
                <Icon height={14} name="mdi:arrow-right" />
              </a>
            </div>
          </section>
        </div>
      </nav>
    </div>

    <!--[if lte IE 9]><script src="//cdnjs.cloudflare.com/ajax/libs/placeholders/3.0.2/placeholders.min.js"></script><![endif]-->
  </body>
</html>

<style>
  main.app-container h1 {
    font-size: 1rem !important;
    line-height: 1.1 !important;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    color: #0c0c0c !important;
  }
  
  main.app-container p {
    font-size: 0.875rem !important;
    line-height: 1.2 !important;
    margin-top: 0.5rem !important;
    margin-bottom: 0 !important;
  }
  
  section.app-container {
    margin-top: -2rem !important;
    margin-bottom: 0 !important;
  }
  
  section.app-container:first-of-type {
    margin-top: -3rem !important;
  }
  
  section.app-container > *:last-child {
    margin-bottom: 0 !important;
  }
  
  section.app-container p {
    font-size: 0.75rem !important;
    line-height: 1.4 !important;
    color: #0c0c0c !important;
  }
  
  .profile-image-container {
    width: 120px;
    height: 120px;
  }
  
  .profile-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
  }
  
  .single-projects-content h4 {
    font-size: 1.5rem;
  }
  
  .single-projects-content .lead {
    font-size: 0.9rem;
    color: #666;
  }
  
  .chips-container-small-width .single-chip {
    font-size: 0.7rem;
    padding: 0.2rem 0.4rem;
  }
  
  .mini-label-white {
    font-size: 0.7rem;
  }
  
  .links-container {
    margin-top: 1rem;
  }
  
  .links-icons-container {
    display: flex;
    justify-content: flex-start;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  
  .link-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid #e0e0e0;
    border-radius: 50%;
    background-color: #fff;
    transition: all 0.3s ease;
    text-decoration: none;
  }
  
  .link-icon:hover {
    background-color: #f5f5f5;
    border-color: #ccc;
    transform: translateY(-2px);
  }
  
  .social-icon {
    width: 20px;
    height: 20px;
  }
  
  @media (max-width: 768px) {
    .profile-image-container {
      width: 80px;
      height: 80px;
    }
    
    .single-projects-content h4 {
      font-size: 1.2rem;
    }
    
    .single-projects-content .lead {
      font-size: 0.8rem;
      line-height: 1.3;
      color: #666;
    }
    
    .chips-container-small-width .single-chip {
      font-size: 0.6rem;
      padding: 0.15rem 0.3rem;
    }
    
    .mini-label-white {
      font-size: 0.6rem;
    }
    
    .links-icons-container {
      gap: 0.8rem;
    }
    
    .link-icon {
      width: 36px;
      height: 36px;
    }
    
    .social-icon {
      width: 18px;
      height: 18px;
    }
  }
</style>
