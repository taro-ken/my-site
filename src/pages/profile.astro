---
import Layout from '../layouts/Layout.astro';
import BackToHome from '../components/BackToHome.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Layout
  title="Profile - taro."
  description="エッセンシャル・ソロクリエイター。大切なものだけを残し、仕事と暮らしを自分で選ぶ。ミニマリズム、働き方、お金、習慣について発信しています。"
>
  <main class="min-h-screen bg-black text-white font-sans selection:bg-white selection:text-black pt-10 pb-12 px-5">
    <div class="max-w-2xl mx-auto">
      <BackToHome />
      <div class="mt-8 flex items-center gap-5">
        <img src="/assets/profile-icon.jpg" alt="" class="w-20 h-20 md:w-24 md:h-24 rounded-full object-cover shrink-0" />
        <div>
          <h1 class="text-2xl font-black mb-4">Taro.</h1>
          <p class="text-zinc-400 leading-relaxed">エッセンシャル・ソロクリエイター</p>
          <p class="mt-4 text-zinc-400 leading-relaxed">
            大切なものだけを残し、仕事と暮らしを自分で選ぶ。<br />
            ミニマリズム、働き方、お金、習慣について発信しています。
          </p>
        </div>
      </div>
    </div>
  </main>
  <SiteFooter />
</Layout>
