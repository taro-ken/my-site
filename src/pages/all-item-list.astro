---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';


// Noteページから動的にデータを取得
const NOTE_URL = "https://note.com/taro_essence/n/n48d515eac42c";

// NoteページのHTMLを直接取得
async function fetchNoteHTML() {
  try {
    const response = await fetch(NOTE_URL, {
      headers: {
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36',
      },
      cache: 'no-store'
    });
    
    if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
    
    const html = await response.text();
    const contentMatch = html.match(/<div[^>]*class="[^"]*note-common-styles__textnote-body[^"]*"[^>]*>(.*?)<\/div>/s);
    
    if (contentMatch) {
      let content = contentMatch[1];
      
      // Cleanup
      content = content.replace(/<p[^>]*>【Profile】[^<]*<\/p>/gi, '');
      content = content.replace(/<p[^>]*>.*?taro\.東京在住のプログラマー.*?<\/p>/gis, '');
      content = content.replace(/<p[^>]*>.*?HOME[：:].*?kentaro\.life.*?<\/p>/gi, '');
      content = content.replace(/<p[^>]*>全ての持ち物をリスト化し[^<]*<\/p>/gs, '');
      content = content.replace(/<p[^>]*>新しい物を購入する際は[^<]*<\/p>/gs, '');
      content = content.replace(/<p[^>]*>※冷蔵庫・洗濯機は[^<]*<\/p>/gs, '');
      content = content.replace(/<p[^>]*>\s*<a[^>]*>[^<]*全アイテムはこちら[^<]*<\/a>\s*<\/p>/gi, '');
      
      content = content.replace(/<ul[^>]*>[\s\S]*?<\/ul>/s, '');
      content = content.replace(/^\s*・\s*/gm, '');
      content = content.replace(/<figure[^>]*class="[^"]*o-noteEyecatch[^"]*"[^>]*>.*?<\/figure>/s, '');
      
      return content;
    }
    return '<p class="text-zinc-500">Noteページの内容を取得できませんでした。</p>';
  } catch (error) {
    console.error('Note fetch failed:', error);
    return `<div class="text-center py-20"><p class="text-zinc-500">Noteデータの取得に失敗しました。</p><a href="${NOTE_URL}" target="_blank" class="text-white underline mt-4 inline-block">Noteで直接見る</a></div>`;
  }
}

const noteHTML = await fetchNoteHTML();
---

<Layout 
  title="Gear - taro."
  description="人生の質を高めてくれる、厳選された愛用アイテムたち。"
>
  <main class="min-h-screen bg-black text-white pt-32 pb-32 px-5 font-sans selection:bg-[#BF953F] selection:text-black">
    <div class="max-w-3xl mx-auto w-full">
      <div class="text-center mb-12 flex flex-col items-center">
              <p class="text-zinc-400 tracking-[0.3em] text-[10px] md:text-xs uppercase mb-4 font-bold">The Gear</p>
              <h1 class="text-4xl md:text-5xl font-black tracking-tight mb-4">
                All Item List
              </h1>
              <p class="text-zinc-400 font-medium max-w-2xl text-sm md:text-base">
                生活を身軽にする、厳選された持ち物と愛用品のリスト
              </p>
              <div class="mt-8 flex justify-center w-full">
                <a
                  href="/gear-review"
                  class="text-accent underline underline-offset-4 decoration-accent font-semibold text-sm hover:opacity-80 transition-opacity"
                >
                  写真付きフルレビュー
                </a>
              </div>
            </div>
            <section class="items-container">
              <div class="note-content md:prose-invert" set:html={noteHTML}></div>
      </section>
      <div class="mt-16 flex justify-center w-full">
        <a
          href="/gear-review"
          class="text-accent underline underline-offset-4 decoration-accent font-semibold text-sm hover:opacity-80 transition-opacity"
        >
          写真付きフルレビュー
        </a>
      </div>
    </div>
  </main>

    <script>
      function applyStyles() {
        const noteContent = document.querySelector('.note-content');
        if (noteContent) {
          const allElements = noteContent.querySelectorAll('*');
          allElements.forEach(el => {
            if (el instanceof HTMLElement) {
              el.style.color = '#d4d4d8'; // zinc-300
              el.style.backgroundColor = 'transparent';
              el.style.borderColor = '#27272a'; // zinc-800
              
              if (el.tagName === 'A') {
                el.style.color = '#a1a1aa'; // zinc-400
                el.style.textDecoration = 'none';
              }
              if (['H1', 'H2', 'H3', 'H4'].includes(el.tagName)) {
                el.style.color = '#ffffff';
              }
            }
          });
        }
      }
      applyStyles();
      document.addEventListener('astro:after-swap', applyStyles);
    </script>
</Layout>

<style is:global>
  body {
    background-color: black;
    color: #d4d4d8;
    margin: 0;
    font-family: system-ui, -apple-system, sans-serif;
  }

  .note-content h1, .note-content h2, .note-content h3, .note-content h4 {
    color: #ffffff !important;
    font-weight: 900;
    letter-spacing: -0.01em;
  }

  .note-content h2 {
    font-size: 1.5rem;
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid #27272a;
    padding-bottom: 0.5rem;
  }

  .note-content h3 {
    font-size: 1.1rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .note-content p {
    line-height: 1.8;
    margin-bottom: 1.5rem;
    color: #d4d4d8 !important;
  }

  .note-content a {
    color: #a1a1aa !important;
    text-decoration: none !important;
  }

  .note-content a:hover {
    color: #ffffff !important;
    text-decoration: none !important;
  }

  .note-content img {
    width: 100%;
    max-width: 100%;
    height: auto;
    border-radius: 4px;
    margin: 1.5rem auto;
    display: block;
  }

  .note-content figure {
    margin: 2rem 0;
  }

  .note-content ul {
    list-style-type: none;
    padding-left: 0;
  }

  .note-content li {
    margin-bottom: 0.5rem;
  }
</style>
