---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

---

<Layout title="Services | KENTARO">
  <main class="min-h-screen bg-black text-white pt-32 pb-32 px-5 font-sans selection:bg-[#BF953F] selection:text-black">
    <div class="max-w-3xl mx-auto w-full">
      <div class="text-center mb-12 flex flex-col items-center">
              <p class="text-zinc-400 tracking-[0.3em] text-[10px] md:text-xs uppercase mb-4 font-bold">The Services</p>
              <h1 class="text-4xl md:text-5xl font-black tracking-tight mb-4">
                Services
              </h1>
              <p class="text-zinc-400 font-medium max-w-2xl text-sm md:text-base">
                実務的なサポートメニュー
              </p>
            </div>
            <section class="items-container">
              <div class="services-container max-w-3xl mx-auto w-full">
                <div class="flex flex-col gap-6">
                  <!-- キャリアカウンセリング -->
                  <div class="service-card">
                    <div class="service-content">
                      <!-- 画像セクションなし -->                      <!-- サービス詳細セクション -->
                      <div class="service-details">
                        <h3 class="service-title">キャリアカウンセリング</h3>
                        
                        <div class="service-info">
                          <div class="service-section">
                            <h4 class="service-subtitle">サービス内容（60分／回）</h4>
                            <p class="service-description">
                              飲食業から未経験でエンジニアに転身し、現在フリーランスとして活動している私の経験と知識をもとに、キャリアに関するヒアリング／アドバイスを行います。
                            </p>
                            <ul class="service-list">
                              <li>
                                <div class="service-item-title">• 現状整理と強みの棚卸し</div>
                              </li>
                              <li>
                                <div class="service-item-title">• 学習ロードマップ提案</div>
                              </li>
                              <li>
                                <div class="service-item-title">• 職務経歴書・ポートフォリオの方向性アドバイス</div>
                              </li>
                              <li>
                                <div class="service-item-title">• 面接対策（想定質問・回答の組み立て）</div>
                              </li>
                              <li>
                                <div class="service-item-title">• 企業・案件の探し方（社員／副業／フリーランスの進め方の違い）</div>
                              </li>
                            </ul>
                          </div>

                          <div class="service-section">
                            <h4 class="service-subtitle">料金</h4>
                            <p class="service-price">無料</p>
                            <p class="service-price-desc">
                              ※継続サポートは別途相談可（回数・内容に応じて個別見積もり）
                            </p>
                            <p class="service-price-desc">
                              ※実施形式：オンライン（Google Meet）
                            </p>
                          </div>
                        </div>

                        <div class="service-button">
                          <a 
                            href="https://forms.gle/WgmL5zMchr7365gC9" 
                            class="service-btn"
                          >
                            申し込む
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- システム開発支援 -->
                  <div class="service-card">
                    <div class="service-content">
                      <!-- 画像セクションなし -->                      <!-- サービス詳細セクション -->
                      <div class="service-details">
                        <h3 class="service-title">システム開発支援</h3>
                        
                        <div class="service-info">
                          <div class="service-section">
                            <h4 class="service-subtitle">サービス内容</h4>
                            <p class="service-description">
                              スマホアプリ・Webサイトの開発支援を行います。
                            </p>
                            <ul class="service-list">
                              <li>
                                <div class="service-item-title">• 企画/要件整理/実装</div>
                              </li>
                            </ul>
                          </div>

                          <div class="service-section">
                            <h4 class="service-subtitle">料金</h4>
                            <p class="service-price">応相談</p>
                          </div>
                        </div>

                        <div class="service-button">
                          <a 
                            href="https://forms.gle/WgmL5zMchr7365gC9" 
                            class="service-btn"
                          >
                            お問い合わせ
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </section>
    </div>
  </main>
</Layout>

<style>
  .services-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 0;
  }

  .service-card {
    border: 1px solid #27272a; /* zinc-800 */
    border-radius: 12px;
    padding: 1.5rem;
    background: #09090b; /* zinc-950 */
    box-shadow: none;
    transition: all 0.3s ease;
  }

  .service-card:hover {
    border-color: #3f3f46; /* zinc-700 */
    background: #18181b; /* zinc-900 */
    transform: translateY(-2px);
  }

  .service-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .service-details {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .service-title {
    font-size: 1.1rem;
    font-weight: bold;
    color: #ffffff;
    margin: 0;
  }

  .service-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .service-section {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .service-subtitle {
    font-size: 0.8rem;
    font-weight: 600;
    color: #e4e4e7; /* zinc-200 */
    margin: 0;
  }

  .service-list {
    color: #a1a1aa; /* zinc-400 */
    font-size: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .service-item-title {
    font-weight: 500;
    color: #d4d4d8; /* zinc-300 */
  }

  .service-item-desc {
    margin-left: 1rem;
    margin-top: 0.25rem;
    font-size: 0.65rem;
  }

  .service-note {
    font-size: 0.75rem;
    color: #a1a1aa;
    margin: 0.25rem 0 0 0;
  }

  .service-price {
    font-size: 0.875rem;
    font-weight: bold;
    color: #ffffff;
    margin: 0;
  }

  .service-price-desc {
    font-size: 0.75rem;
    color: #a1a1aa;
    margin: 0;
  }

  .service-cancel {
    font-size: 0.75rem;
    color: #a1a1aa;
    margin: 0;
  }

  .service-description {
    font-size: 0.75rem;
    color: #a1a1aa;
    line-height: 1.6;
    margin: 0 0 0.5rem 0;
  }

  .service-button {
    padding-top: 0.5rem;
    text-align: center;
  }

  .service-btn {
    display: inline-block;
    padding: 0.6rem 2rem;
    background: #ffffff;
    color: #000000;
    font-size: 0.7rem;
    font-weight: 700;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s;
  }

  .service-btn:hover {
    background: #a1a1aa; /* zinc-400 */
  }

</style>
