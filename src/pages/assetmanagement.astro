---
import Layout from '../layouts/Layout.astro';
import MoneySimulator from '../components/MoneySimulator';
import BackToHome from '../components/BackToHome.astro';
import '../styles/global.css';

---

<Layout
  title="Asset- taro."
  description="長期的な自由を手に入れるための資産配分戦略。"
>
  <div class="assetmanagement-body bg-black text-white min-h-screen pt-10 pb-32 px-5">
    <BackToHome />
    <main class="mt-8">
      <MoneySimulator client:load />
    </main>
  </div>
</Layout>
<style is:global>
  /* このページだけ余白も含めて全面黒にする（global.css の body 背景を上書き） */
  html.bg-black,
  html.bg-black body.assetmanagement-body {
    background-color: #000000 !important;
    background: #000000 !important;
  }
  html.bg-black {
    min-height: 100%;
  }
</style>
