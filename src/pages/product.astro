---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

type ProductItem = {
  title: string;
  description: string;
  link: string;
  image?: string;
  linkText: string;
  external?: boolean;
};

/** ブログとは別の「教材」専用。項目はここで編集してください。 */
const categories: {
  id: string;
  labelEn: string;
  labelJa: string;
  items: ProductItem[];
  /** セクション見出しタップで遷移する教材専用ページ（任意） */
  materialsPage?: string;
}[] = [
  {
    id: 'book',
    labelEn: 'Book & Guide',
    labelJa: 'ブック・ガイド',
    items: [
      {
        title: '- 50 Minimal Life Rules -',
        description:
          '日々の暮らしで大切にしている「手放す技術」や、人生における心とお金にゆとりを生むための考え方。',
        link: 'https://kentaro.life/send',
        image: '/assets/resource/50rules.png',
        linkText: 'Download Free',
        external: true,
      },
      {
        title: 'The Golden Rule of Asset Allocation',
        description:
          '安定した資産形成と経済的自由を実現するポートフォリオ戦略。時代を超えて機能するシミュレーター。',
        link: '/assetmanagement',
        image: '/assets/resource/goldenrules.png',
        linkText: 'Read Guide',
      },
    ],
  },
  {
    id: 'materials',
    labelEn: 'Materials',
    labelJa: '教材',
    materialsPage: '/engineering-roadmap',
    items: [
      {
        title: 'AI時代に未経験からエンジニアになり、最短で収入を4倍にする方法',
        description:
          '学習の順番とチェックポイントをフェーズ別に整理。焦らず続けるための道しるべです。',
        link: '/engineering-roadmap',
        image: '/assets/engineer-loadmap.png',
        linkText: 'Read more',
      },
    ],
  },
  {
    id: 'application',
    labelEn: 'Application',
    labelJa: 'アプリ',
    items: [
      {
        title: 'MyTube',
        description:
          'おすすめ動画、ショート動画、コメント、動画内広告をすべて排除。あなたの大切な時間を守るための集中用 YouTube アプリ。',
        link: 'https://apps.apple.com/jp/app/id6447217754',
        image: '/assets/app/4.png',
        linkText: 'View App',
        external: true,
      },
      {
        title: 'Focusy',
        description:
          'デジタルノイズを強制シャットアウト。指定したアプリをロックし、あなたから奪われた集中力を取り戻すためのツール。',
        link: 'https://apps.apple.com/jp/app/id6747918924',
        image: '/assets/app/5.png',
        linkText: 'View App',
        external: true,
      },
    ],
  },
];
---

<Layout
  title="Products | Taro Essence"
  description="ブック・ガイド、アプリ、教材。Freedom & Focus のリソース一覧。"
  canonicalUrl="https://kentaro.life/product"
>
  <main class="min-h-screen bg-black text-white font-sans selection:bg-white selection:text-black pb-16 md:pb-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-5 pt-24 md:pt-28 pb-5">
      <p class="text-zinc-500 tracking-[0.25em] text-[9px] uppercase mb-2 font-bold text-center">Resources</p>
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-center mb-2">Freedom & Focus</h1>
      <p class="text-zinc-500 font-medium text-center max-w-xl mx-auto text-[10px] md:text-[11px] leading-relaxed">

      </p>
    </div>

    {categories.map((cat) => (
      <section id={cat.id} class="max-w-5xl mx-auto px-4 sm:px-5 py-5 md:py-6 border-t border-zinc-900/80 scroll-mt-20">
        <div class="mb-4 md:mb-5 flex flex-wrap items-baseline gap-x-3 gap-y-1">
          {cat.materialsPage ? (
            <a
              href={cat.materialsPage}
              class="group flex flex-wrap items-baseline gap-x-3 gap-y-1 rounded-sm -mx-1 px-1 -my-0.5 py-0.5 transition-colors hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              <h2 class="text-base md:text-lg font-black tracking-tight">{cat.labelEn}</h2>
              <span class="text-[10px] text-zinc-600 font-medium tracking-wider uppercase group-hover:text-zinc-500">
                {cat.labelJa}
              </span>
            </a>
          ) : (
            <>
              <h2 class="text-base md:text-lg font-black tracking-tight">{cat.labelEn}</h2>
              <span class="text-[10px] text-zinc-600 font-medium tracking-wider uppercase">{cat.labelJa}</span>
            </>
          )}
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4">
          {cat.items.map((item) => (
            <div class="flex flex-col group rounded-md border border-zinc-900/80 bg-zinc-950/40 p-3 hover:border-zinc-800 transition-colors">
              <a
                href={item.link}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
                class="relative block mb-2.5 w-full shrink-0 overflow-hidden rounded-[3px] bg-zinc-900 aspect-video"
              >
                {item.image ? (
                  <img
                    src={`${item.image}?w=640&q=80&fmt=webp`}
                    alt={item.title}
                    class="h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                ) : (
                  <div class="absolute inset-0 flex items-center justify-center text-zinc-600 text-[10px] uppercase tracking-widest">
                    No Image
                  </div>
                )}
              </a>
              <a
                href={item.link}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
                class="flex flex-col flex-1 min-w-0"
              >
                <h3 class="text-sm md:text-[15px] font-bold mb-1 leading-snug group-hover:text-zinc-300 transition-colors line-clamp-2">
                  {item.title}
                </h3>
                {cat.id !== 'materials' && (
                  <p class="text-zinc-500 text-[10px] md:text-[11px] mb-2.5 leading-relaxed flex-1 line-clamp-3">
                    {item.description}
                  </p>
                )}
                <div class="flex items-center text-[10px] md:text-xs font-bold text-zinc-300 group-hover:text-accent transition-colors">
                  <svg class="w-3 h-3 mr-1.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
                    />
                  </svg>
                  {item.linkText}
                </div>
              </a>
            </div>
          ))}
        </div>
      </section>
    ))}

    <div class="max-w-5xl mx-auto px-4 sm:px-5 pt-6 pb-3 text-center">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.35em] text-zinc-600 hover:text-accent transition-colors"
      >
        ← Back to Home
      </a>
    </div>
  </main>
</Layout>

<style>
  html {
    background-color: black;
  }
</style>
