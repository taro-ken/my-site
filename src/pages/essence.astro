    opacity: 0;
    pointer-events: none;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.3s ease;
  }
  .floating-cta :global(.dl-btn) { backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
  .floating-cta :global(.dl-btn.off) { background: rgba(24, 24, 27, 0.92); }
  .floating-cta.show {
    transform: translate(-50%, 0);
    opacity: 1;
    pointer-events: auto;
  }
  .float { animation: float 7s ease-in-out infinite; }
  .float-slow { animation: float 9s ease-in-out infinite; }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }



  /* ── reveal on scroll (only hides content once JS has flagged the page) ── */
  :global(html.js-reveal) .reveal {
    opacity: 0;
    transform: translateY(26px);
    transition: opacity 0.9s ease, transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: var(--d, 0ms);
  }
  :global(html.js-reveal) .reveal.is-visible {
    opacity: 1;
    transform: none;
  }
  .card.reveal.is-visible:hover { transform: translateY(-3px); transition-delay: 0ms; }

  @media (prefers-reduced-motion: reduce) {
    .pa, .float, .float-slow, .gradient-text, .skeleton { animation: none !important; }
    :global(html.js-reveal) .reveal { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  const revealTargets = document.querySelectorAll<HTMLElement>('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );
    revealTargets.forEach((el) => io.observe(el));
  } else {
    revealTargets.forEach((el) => el.classList.add('is-visible'));
  }

  const floatingCta = document.getElementById('floating-cta');
  const finalCta = document.getElementById('final-cta');
  if (floatingCta) {
    let finalCtaVisible = false;
    const update = () => floatingCta.classList.toggle('show', window.scrollY > 520 && !finalCtaVisible);
    if (finalCta && 'IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        finalCtaVisible = entries[0].isIntersecting;
        update();
      }, { threshold: 0.25 }).observe(finalCta);
    }
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  document.querySelectorAll<HTMLElement>('.course-carousel').forEach((carousel) => {
    const scroller = carousel.querySelector<HTMLElement>('.course-marquee');
    const slide = carousel.querySelector<HTMLElement>('.course-slide');
    const arrows = carousel.querySelectorAll<HTMLButtonElement>('.course-arrow');
    if (!scroller || !slide) return;
    const sync = () => {
      const max = scroller.scrollWidth - scroller.clientWidth - 2;
      arrows.forEach((btn) => {
        btn.disabled = Number(btn.dataset.dir) < 0 ? scroller.scrollLeft <= 2 : scroller.scrollLeft >= max;
      });
    };
    arrows.forEach((btn) => {
      btn.addEventListener('click', () => {
        scroller.scrollBy({ left: Number(btn.dataset.dir) * (slide.offsetWidth + 12), behavior: 'smooth' });
      });
    });
    scroller.addEventListener('scroll', sync, { passive: true });
    sync();
  });

  document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
    card.addEventListener('pointermove', (e) => {
      const rect = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${e.clientX - rect.left}px`);
      card.style.setProperty('--my', `${e.clientY - rect.top}px`);
    });
  });
</script>
