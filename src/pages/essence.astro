    opacity: 0.75;
    transition: opacity 0.3s ease;
  }
  .card:hover {
    border-color: color-mix(in srgb, var(--c) 45%, transparent);
    background: rgba(255, 255, 255, 0.045);
  }
  .card > * { position: relative; }
  .icon-chip {
