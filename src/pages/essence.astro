<style>
  .essence-page {
    --emerald: #10b981;
    --teal: #0d9488;
    --mint: #34d399;
    --sea: #0891b2;
  }

  /* ── typography helpers ── */
  .essence-page h1,
  .essence-page h2,
  .essence-page h3 {
    text-wrap: balance;
    word-break: auto-phrase;
  }
  .essence-page p,
  .essence-page dd,
  .essence-page li {
    text-wrap: pretty;
    word-break: auto-phrase;
  }
  .eyebrow {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgba(110, 231, 183, 0.85);
  }
  .gradient-text {
    background: linear-gradient(100deg, #6ee7b7 0%, #ffffff 45%, #67e8f9 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shimmer 9s linear infinite;
  }
  .gradient-text-static {
    background: linear-gradient(120deg, #6ee7b7, #ffffff 70%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  @keyframes shimmer {
    to { background-position: 200% center; }
  }

  /* ── background ── */
  .page-aurora {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .pa {
    position: absolute;
    width: var(--w);
    height: var(--w);
    border-radius: 9999px;
    opacity: var(--o, 1);
    background: radial-gradient(closest-side, rgba(var(--pc), 0.6) 0%, rgba(var(--pc), 0.24) 48%, rgba(var(--pc), 0) 100%);
    will-change: transform;
    animation: drift 24s ease-in-out infinite alternate;
  }
  @media (max-width: 767px) {
    .pa {
      width: calc(var(--w) * 0.62);
      height: calc(var(--w) * 0.62);
    }
  }
  @keyframes drift {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(48px, -36px, 0) scale(1.14); }
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--mint);
    box-shadow: 0 0 10px var(--mint);
  }


  /* ── cards ── */
  .card {
    position: relative;
    overflow: hidden;
    border-radius: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: rgba(255, 255, 255, 0.03);
    transition: border-color 0.3s ease, transform 0.3s ease, background 0.3s ease;
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(420px circle at var(--mx, 85%) var(--my, 0%), color-mix(in srgb, var(--c) 20%, transparent), transparent 62%);
    opacity: 0.75;
    transition: opacity 0.3s ease;
  }
  .card:hover {
    border-color: color-mix(in srgb, var(--c) 45%, transparent);
    background: rgba(255, 255, 255, 0.045);
  }
  .card > * { position: relative; }
  .icon-chip {
    display: inline-flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    color: var(--c);
    background: color-mix(in srgb, var(--c) 16%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c) 28%, transparent);
  }
  .feature-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 200px;
    padding: 16px 18px;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(0, 0, 0, 0.4);
  }
  .feature-visual > * { width: 100%; }
  @media (max-width: 767px) {
    .feature-visual { display: none; }
  }
  .skeleton {
    height: 9px;
    border-radius: 9999px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.07));
    background-size: 200% 100%;
    animation: skel 2.8s ease-in-out infinite;
  }
  @keyframes skel {
    from { background-position: 100% 0; }
    to { background-position: -100% 0; }
  }
  .wave-bar {
    flex: 1;
    min-width: 2px;
