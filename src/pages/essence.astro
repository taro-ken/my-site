---
import Layout from '../layouts/Layout.astro';
import EssenceDownloadButton from '../components/EssenceDownloadButton.astro';
import BackToHome from '../components/BackToHome.astro';
import { ESSENCE_JOIN_OPEN } from '../lib/essence';

// Webからの申し込み(Stripe)が開いている間だけ、Web決済に触れる文言にする。閉じている間はアプリ内課金(App Store)のみを案内する。
const webOpen = ESSENCE_JOIN_OPEN;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://taroessence.com';
const pageUrl = `${siteUrl}/essence`;

// ログイン済みならダッシュボードへ、未ログインなら新規登録へ。
const joinHref = Astro.locals.isLoggedIn ? '/dashboard' : '/register';

const icons: Record<string, string> = {
  mic: '<path d="M12 2a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M19 10v1a7 7 0 0 1-14 0v-1M12 18v4M8 22h8"/>',
  play: '<circle cx="12" cy="12" r="10"/><path d="M10 8l6 4-6 4z"/>',
  chat: '<path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.5 8.5 0 0 1-3.8-.9L3 21l1.9-5.2A8.4 8.4 0 1 1 21 11.5z"/>',
  box: '<path d="M21 8l-9-5-9 5v8l9 5 9-5z"/><path d="M3 8l9 5 9-5M12 13v8"/>',
  yen: '<circle cx="12" cy="12" r="10"/><path d="M8 7l4 5 4-5M8 12h8M8 15h8M12 12v6"/>',
  leaf: '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10z"/><path d="M2 21c0-3 1.9-5.4 5.5-7.5"/>',
  heart: '<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"/>',
  check: '<path d="M5 13l4 4L19 7"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  spark: '<path d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M18.4 5.6l-2.8 2.8M8.4 15.6l-2.8 2.8"/>',
};

const pillars = [
  { t: '減らす力', d: 'モノ・支出・義務・情報を見直し、自分のための時間と余白をつくる。', icon: 'box', color: '#34D399' },
  { t: '創る力', d: 'プログラミングやものづくりを通じて、自分の力で仕事と収入の選択肢をつくる。', icon: 'spark', color: '#10B981' },
  { t: '蓄える力', d: '支出を最適化し、資産を育て、将来の選択肢を増やす。', icon: 'yen', color: '#0891B2' },
  { t: '整える力', d: '運動・習慣・瞑想を通じて、心身の健康と集中できる状態を保つ。', icon: 'leaf', color: '#0D9488' },
];

const sampleItems = [
  { name: 'iPhone13mini', meta: '¥98,000 ・ 週に7回' },
  { name: 'AirPods Pro2', meta: '¥35,999 ・ 週に7回' },
  { name: 'MagSafe Wallet', meta: '¥10,853' },
];

const meditationSounds = [
  { name: '静寂', bg: 'linear-gradient(160deg,#2b2a5a,#151a33)', active: true },
  { name: 'Boundless', bg: 'linear-gradient(160deg,#14a085,#0b4d3e)', active: false },
  { name: 'Sunrise', bg: 'linear-gradient(160deg,#f59e0b,#be123c)', active: false },
];

const healthStats = [
  { value: '42,180', label: '歩数' },
  { value: '6h52m', label: '睡眠' },
  { value: '3回', label: '運動' },
];

const healthDaily = [
  { day: '月', h: 22 },
  { day: '火', h: 34 },
  { day: '水', h: 18 },
  { day: '木', h: 40 },
  { day: '金', h: 28 },
  { day: '土', h: 24 },
  { day: '日', h: 36, today: true },
];

const wave = Array.from({ length: 40 }, (_, i) => Math.round(25 + Math.abs(Math.sin(i * 1.7) * 50 + Math.cos(i * 0.9) * 20)));

const courseShowcase = [
  { id: 'minimalism', tag: 'ミニマリズム', title: '過剰からの救済 ― 5つの過剰から、選べる人生を取り戻す' },
  { id: 'web', tag: 'Webアプリ開発', title: 'バイブコーディングで、未経験からWebアプリをつくる' },
  { id: 'native', tag: 'スマホアプリ開発', title: 'バイブコーディングで、未経験からスマホアプリをリリースする' },
  { id: 'breath', tag: 'ヘルスケア', title: '呼吸から整える、毎日のメンタル・メンテナンス' },
];

const practiceTools = [
  {
    id: 'items', en: 'Item List', jp: '持ち物リスト', icon: 'box', color: '#34D399',
    body: '本当に必要なものを可視化するツール',
  },
  {
    id: 'meditation', en: 'Meditation Timer', jp: '瞑想タイマー', icon: 'leaf', color: '#34D399',
    body: '呼吸で精神を安定させる、現代の必須科目',
  },
  {
    id: 'balance', en: 'Balance Sheet', jp: 'バランスシート', icon: 'yen', color: '#0891B2',
    body: '数字を把握し、不要を手放す',
  },
  {
    id: 'health', en: 'Healthcare', jp: 'ヘルスケア', icon: 'heart', color: '#0D9488',
    body: '選び続けるための土台となる体を観察',
  },
];

const pricingPoints = [
  'メンバー向け動画講座',
  'メンバー限定Podcast',
  '利用可能な実践ツール',
  '新しいコンテンツへのアクセス',
];

const footerLinks = [
  { href: '/essence/info#billing', label: '課金・解約・返金について' },
  { href: '/essence/info#operator', label: 'サービス運営者情報' },
  { href: '/privacy', label: 'プライバシーポリシー' },
  { href: '/terms', label: '利用規約' },
  { href: '/tokushoho', label: '特定商取引法に基づく表記' },
];

const faq = [
  {
    q: 'Essenceでは何ができますか？',
    a: '動画講座、メンバー限定Podcast、実践ツール（持ち物リスト、瞑想タイマー、バランスシート、ヘルスケア）を通じて、時間・お金・働き方・習慣について学び、日常で実践できます。動画講座はiPhoneアプリとWebブラウザの両方で視聴できます。コミュニティは準備中です。',
  },
  {
    q: 'どの端末で利用できますか？',
    a: 'EssenceはiPhoneアプリ（iOS 17以降）を中心としたメンバーシップです。動画講座はWebブラウザからも視聴できます。現在、Androidアプリには対応していません。',
  },
  {
    q: 'どのような人に向いていますか？',
    a: '余計なものを減らし、本当に大切なことに集中したい人。今の働き方や習慣を見直し、自分の人生の選択肢を増やしたい人に向けたサービスです。',
  },
  {
    q: 'コンテンツはどのくらいの頻度で追加されますか？',
    a: '講座とPodcastは継続して追加しています。公開のタイミングはアプリ内の一覧でご確認ください。',
  },
  {
    q: 'いつでも解約できますか？',
    a: (webOpen
      ? 'はい、いつでも解約できます。App Storeで登録した場合はアプリの「設定」→「サブスクリプションを管理」から、Webサイトで登録した場合は「設定」→「サブスクリプションを解約する」から手続きできます。'
      : 'はい、いつでも解約できます。アプリの「設定」→「サブスクリプションを管理」（またはiPhoneの設定アプリ → Apple ID → サブスクリプション）から手続きできます。')
      + '詳細は<a href="/essence/info#billing" class="underline underline-offset-4 hover:text-white">課金・解約・返金について</a>をご確認ください。',
  },
  {
    q: '解約するとコンテンツはどうなりますか？',
    a: '次回更新日の前日までに解約すると、それ以降の請求は発生しません。お支払い済みの期間が終わるまでは、これまでどおりご利用いただけます。期間終了後はメンバー向けコンテンツ・ツールをご利用いただけなくなります。',
  },
];

const pageDescription =
  '余計なものを減らし、本当に大切なことに集中する。時間・お金・働き方・習慣を、自分の意思で選ぶための学びと実践のメンバーシップ。月額1,500円（税込）。';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Essence',
  url: pageUrl,
  operatingSystem: 'iOS 17+',
  applicationCategory: 'LifestyleApplication',
  description: pageDescription,
  image: `${siteUrl}/assets/essence/app-icon.png`,
  offers: {
    '@type': 'Offer',
    price: '1500',
    priceCurrency: 'JPY',
    description: '月額メンバーシップ（税込・1か月ごとの自動更新）',
  },
  publisher: { '@type': 'Person', name: 'taro essence', url: siteUrl },
};
---

<Layout
  title="Essence｜選べる人生を、創る。"
  description={pageDescription}
  keywords="Essence, taro essence, ミニマリズム, メンバーシップ, Podcast, 講座, 働き方, 習慣"
  ogImage="/assets/essence/app-icon.png"
>
  <script is:inline>document.documentElement.classList.add('js-reveal');</script>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="essence-page relative isolate bg-black text-white font-normal overflow-x-clip selection:bg-emerald-300 selection:text-black">

    <div class="relative z-10 px-5 md:px-8 pt-6">
      <BackToHome />
    </div>

    <div class="page-aurora" aria-hidden="true">
      <span class="pa" style="--pc:16,185,129;--w:760px;--o:.85;left:-24%;top:0%"></span>
      <span class="pa" style="--pc:8,145,178;--w:700px;--o:.75;right:-22%;top:2%;animation-delay:-6s"></span>
      <span class="pa" style="--pc:52,211,153;--w:620px;--o:.32;left:24%;top:9%;animation-delay:-11s"></span>
      <span class="pa" style="--pc:13,148,136;--w:720px;--o:.5;right:-24%;top:27%"></span>
      <span class="pa" style="--pc:16,185,129;--w:760px;--o:.5;left:-26%;top:46%;animation-delay:-9s"></span>
      <span class="pa" style="--pc:8,145,178;--w:720px;--o:.5;right:-24%;top:63%;animation-delay:-4s"></span>
      <span class="pa" style="--pc:52,211,153;--w:760px;--o:.4;left:14%;top:79%"></span>
      <span class="pa" style="--pc:8,145,178;--w:760px;--o:.55;right:-14%;top:91%;animation-delay:-13s"></span>
    </div>

    {/* ───────────── HERO ───────────── */}
    <section class="hero relative pt-16 md:pt-28 pb-5 md:pb-20">
      <div class="hero-layout max-w-6xl mx-auto px-5 md:px-8">
        <div class="hero-copy min-w-0">
          <h1 class="reveal hero-title font-bold tracking-tight" style="--d:80ms">
            選べる人生を、<span class="gradient-text">創る</span>
          </h1>

          <p class="reveal hero-lead mt-3 sm:mt-4 text-zinc-300 max-w-xl" style="--d:160ms">
            余計なものを減らし、本当に大切なことに集中する。<br class="hidden sm:inline" />
            人生の選択肢を増やすための、学びと実践のメンバーシップ。
          </p>
        </div>

        <div class="hero-visual reveal" style="--d:200ms">
          <div class="hero-phone relative min-w-0 mx-auto">
            <div class="phone-glow" aria-hidden="true"></div>
            <div class="phone float" role="img" aria-label="Essenceのホーム画面のイメージ">
              <img src="/assets/essence/home-device.png" alt="" class="phone-device" width="838" height="1698" loading="eager" decoding="async" />
            </div>
          </div>
          <a href="#essence" class="hero-cta">
            Essenceを知る <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
    </section>

    {/* ───────────── 01 THE ESSENCE ───────────── */}
    <section id="essence" class="max-w-4xl mx-auto px-5 md:px-8 pb-14 md:pb-24">
      <div class="text-center mb-8 md:mb-10">
        <p class="reveal section-num">THE ESSENCE</p>
        <h2 class="reveal section-heading mt-4 font-bold tracking-tight" style="--d:80ms">大切なことに、集中する。</h2>
        <div class="reveal mt-4 md:mt-5 mx-auto max-w-xl space-y-3 text-[13px] sm:text-sm md:text-base leading-relaxed text-zinc-300" style="--d:100ms">
          <p>すべてを手に入れる必要はない。</p>
          <p>余計なものを減らし、本当に大切なことに時間とエネルギーを注ぐ。</p>
        </div>
      </div>

      <div class="pillar-list">
        {pillars.map((p, i) => (
          <article class="pillar-item reveal" style={`--d:${i * 70}ms`}>
            <span class="pillar-num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="pillar-title">{p.t}</h3>
            <p class="pillar-body">{p.d}</p>
          </article>
        ))}
      </div>
    </section>

    {/* ───────────── 02 CONTENTS ───────────── */}
    <section id="contents" class="max-w-4xl mx-auto px-5 md:px-8 py-14 md:py-24">
      <div class="text-center mb-8 md:mb-14">
        <p class="reveal section-num">CONTENTS</p>
        <h2 class="reveal section-heading mt-4 font-bold tracking-tight" style="--d:80ms">学ぶ。考える。実践する。</h2>
        <p class="reveal mt-4 text-[13px] sm:text-sm text-zinc-400 max-w-lg mx-auto leading-relaxed" style="--d:60ms">
          知識を得るだけで終わらせない。<br />
          自分の人生に取り入れ、少しずつ変えていくためのコンテンツとツールを届けます。
        </p>
      </div>

      <div class="contents-stack flex flex-col gap-3 md:gap-4">
      {/* 学ぶ */}
      <article class="feature-card card reveal p-4 md:p-7 flex flex-col text-left" style="--c:#10B981">
        <p class="text-[10px] md:text-xs font-bold tracking-[0.2em] uppercase text-zinc-400">Video Courses</p>
        <h3 class="mt-1 text-base md:text-lg font-bold tracking-tight">学ぶ</h3>
        <p class="mt-1 md:mt-3 text-[13px] md:text-sm leading-[1.7] md:leading-[1.9] text-zinc-300">
          ミニマリズム、プログラミング、健康などをテーマに、本質的な知識と実践方法を体系的に学ぶ。動画講座は、iPhoneアプリでもWebブラウザでも視聴できます。
        </p>
        <p class="mt-1.5 md:mt-2 text-xs font-bold text-emerald-300/80">※ 月1〜2回更新。</p>
        <div class="feature-visual mt-4 md:mt-6" aria-hidden="true">
          <div class="course-carousel">
            <div class="course-marquee">
              <div class="course-track">
                {courseShowcase.map((c) => (
                  <div class="course-slide">
                    <img src={`/assets/essence/course-thumb-${c.id}.jpg`} alt="" width="640" height="360" loading="lazy" decoding="async" />
                    <span class="course-tag">{c.tag}</span>
                    <p class="course-title">{c.title}</p>
                  </div>
                ))}
              </div>
            </div>
            {[-1, 1].map((dir) => (
              <button type="button" class={`course-arrow ${dir < 0 ? 'prev' : 'next'}`} data-dir={dir} tabindex="-1" disabled={dir < 0}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d={dir < 0 ? 'M15 18l-6-6 6-6' : 'M9 18l6-6-6-6'} /></svg>
              </button>
            ))}
          </div>
        </div>
      </article>

      {/* 考える */}
      <article class="feature-card card reveal p-4 md:p-7 flex flex-col text-left" style="--c:#34D399;--d:60ms">
        <p class="text-[10px] md:text-xs font-bold tracking-[0.2em] uppercase text-zinc-400">Members Podcast</p>
        <h3 class="mt-1 text-base md:text-lg font-bold tracking-tight">考える</h3>
        <p class="mt-1 md:mt-3 text-[13px] md:text-sm leading-[1.7] md:leading-[1.9] text-zinc-300">
          働き方、お金、習慣、生き方について、動画では語りきれない思考や経験を音声で共有する。
        </p>
        <p class="mt-1.5 md:mt-2 text-xs font-bold text-emerald-300/80">※ 週1回更新。</p>
        <div class="feature-visual mt-4 md:mt-6" aria-hidden="true">
          <div class="text-[10px]">
            <p class="font-bold tracking-[0.2em] text-emerald-400 text-[8px]">NOW PLAYING</p>
            <p class="mt-1 text-zinc-500">EP 2 ・ 10分</p>
            <p class="mt-0.5 text-sm font-bold text-zinc-100">30代の投資戦略</p>
            <div class="mt-3 flex items-center gap-[3px] h-9">
              {wave.map((h, k) => (
                <span class={`flex-1 min-w-[2px] rounded-full ${k < wave.length * 0.35 ? 'bg-emerald-400' : 'bg-white/15'}`} style={`height:${h}%`}></span>
              ))}
            </div>
            <div class="mt-1.5 flex justify-between text-zinc-500 tabular-nums"><span>03:12</span><span>10:00</span></div>
            <div class="mt-2 flex items-center justify-center gap-6 text-zinc-300">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M11 17l-5-5 5-5M18 17l-5-5 5-5" /></svg>
              <span class="w-9 h-9 rounded-full flex items-center justify-center bg-emerald-400 text-black">
                <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M7 5h4v14H7zM13 5h4v14h-4z" /></svg>
              </span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M13 17l5-5-5-5M6 17l5-5-5-5" /></svg>
            </div>
          </div>
        </div>
      </article>

      {/* 実践する */}
      <article class="feature-card card reveal p-4 md:p-7 flex flex-col text-left" style="--c:#0D9488;--d:120ms">
        <p class="text-[10px] md:text-xs font-bold tracking-[0.2em] uppercase text-zinc-400">Practical Tools</p>
        <h3 class="mt-1 text-base md:text-lg font-bold tracking-tight">実践する</h3>
        <p class="mt-1 md:mt-3 text-[13px] md:text-sm leading-[1.7] md:leading-[1.9] text-zinc-300">
          持ち物の見直し、瞑想、資産管理、健康管理など、学んだことを日常に取り入れるためのツール。
        </p>
        <div class="grid gap-2 md:gap-4 mt-4 md:mt-6 sm:grid-cols-2">
          {practiceTools.map((f, i) => (
            <div class="tool-card rounded-[2px] border border-white/10 bg-black/30 p-4 md:p-6 flex flex-col" style={`--c:${f.color}`}>
              <div class="contents md:flex md:items-center md:gap-3 md:mb-3">
                <span class="icon-chip" style={`--c:${f.color}`}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" set:html={icons[f.icon]} />
                </span>
                <span class="text-[10px] md:text-xs font-bold tracking-[0.2em] uppercase text-zinc-400">{f.en}</span>
              </div>
              <h4 class="mt-0.5 md:mt-0 text-sm md:text-base font-bold tracking-tight">{f.jp}</h4>
              <p class="mt-1 text-[13px] md:text-sm leading-relaxed text-zinc-300">{f.body}</p>

              <div class="feature-visual mt-4" aria-hidden="true">
                {f.id === 'items' && (
                  <div class="text-xs">
                    <div class="flex items-center gap-2">
                      <span class="text-[11px] font-bold text-zinc-200">Portable</span>
                      <span class="px-1.5 rounded-full text-[9px] font-bold text-black bg-emerald-400">6</span>
                    </div>
                    <div class="mt-2 space-y-1.5">
                      {sampleItems.map((item) => (
                        <div class="flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg bg-white/[0.05] border border-white/[0.07]">
                          <span class="w-7 h-7 shrink-0 rounded-md flex items-center justify-center" style="background:rgba(52,211,153,.16);color:#34D399">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5" set:html={icons.box} />
                          </span>
                          <div class="min-w-0">
                            <p class="font-bold text-[11px] text-zinc-100 truncate">{item.name}</p>
                            <p class="text-[9px] text-zinc-500">{item.meta}</p>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
                {f.id === 'balance' && (
                  <div class="text-[10px]">
                    <div class="rounded-xl p-3 text-white bg-gradient-to-br from-emerald-500 via-teal-500 to-cyan-600 shadow-[0_10px_30px_-10px_rgba(16,185,129,0.6)]">
                      <p class="text-[8px] font-bold tracking-[0.2em] text-white/80">NET WORTH<span class="ml-1.5 tracking-normal">純資産</span></p>
                      <p class="mt-1 text-2xl font-black tracking-tight">¥32,400,000</p>
                    </div>
                  </div>
                )}
                {f.id === 'meditation' && (
                  <div class="flex items-center gap-4">
