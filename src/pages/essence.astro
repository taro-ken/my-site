    :global(html.js-reveal) .reveal { opacity: 1; transform: none; transition: none; }
  }

  .pillar-list {
    display: grid;
    grid-template-columns: 1fr;
    max-width: 40rem;
    margin-inline: auto;
  }
  .pillar-item {
    padding: 1.25rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    background: transparent;
  }
  .pillar-item:last-child {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .pillar-num {
    display: block;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.2em;
    color: rgba(110, 231, 183, 0.85);
  }
  .pillar-title {
    margin-top: 0.45rem;
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .pillar-body {
    margin-top: 0.4rem;
    font-size: 12px;
    line-height: 1.7;
    color: #d4d4d8;
  }
  @media (min-width: 640px) {
    .pillar-list {
      grid-template-columns: 1fr 1fr;
      max-width: none;
      column-gap: 3.5rem;
    }
    .pillar-item {
      padding: 2rem 0;
    }
    .pillar-item:nth-child(odd) {
      padding-right: 0.5rem;
    }
    .pillar-item:nth-child(even) {
      padding-left: 0.5rem;
    }
    .pillar-item:nth-last-child(-n + 2) {
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .pillar-num {
      font-size: 11px;
    }
    .pillar-title {
      margin-top: 0.65rem;
      font-size: 1.125rem;
    }
    .pillar-body {
      margin-top: 0.55rem;
      font-size: 0.875rem;
      line-height: 1.8;
