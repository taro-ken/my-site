    font-weight: 800;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(110, 231, 183, 0.85);
  }
</style>

<script>
  const revealTargets = document.querySelectorAll<HTMLElement>('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );
    revealTargets.forEach((el) => io.observe(el));
  } else {
    revealTargets.forEach((el) => el.classList.add('is-visible'));
  }

  const floatingCta = document.getElementById('floating-cta');
  const finalCta = document.getElementById('final-cta');
  if (floatingCta) {
    let finalCtaVisible = false;
    const update = () => floatingCta.classList.toggle('show', window.scrollY > 520 && !finalCtaVisible);
    if (finalCta && 'IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        finalCtaVisible = entries[0].isIntersecting;
        update();
      }, { threshold: 0.25 }).observe(finalCta);
    }
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  document.querySelectorAll<HTMLElement>('.course-carousel').forEach((carousel) => {
    const scroller = carousel.querySelector<HTMLElement>('.course-marquee');
    const slide = carousel.querySelector<HTMLElement>('.course-slide');
    const arrows = carousel.querySelectorAll<HTMLButtonElement>('.course-arrow');
    if (!scroller || !slide) return;
    const sync = () => {
      const max = scroller.scrollWidth - scroller.clientWidth - 2;
      arrows.forEach((btn) => {
        btn.disabled = Number(btn.dataset.dir) < 0 ? scroller.scrollLeft <= 2 : scroller.scrollLeft >= max;
      });
    };
    arrows.forEach((btn) => {
      btn.addEventListener('click', () => {
        scroller.scrollBy({ left: Number(btn.dataset.dir) * (slide.offsetWidth + 12), behavior: 'smooth' });
      });
    });
    scroller.addEventListener('scroll', sync, { passive: true });
    sync();
  });

  document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
    card.addEventListener('pointermove', (e) => {
      const rect = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${e.clientX - rect.left}px`);
      card.style.setProperty('--my', `${e.clientY - rect.top}px`);
    });
  });
</script>
