---
import Layout from '../layouts/Layout.astro';
import EssenceDownloadButton from '../components/EssenceDownloadButton.astro';
import BackToHome from '../components/BackToHome.astro';
import { ESSENCE_JOIN_OPEN } from '../lib/essence';

// Webからの申し込み(Stripe)が開いている間だけ、Web決済に触れる文言にする。閉じている間はアプリ内課金(App Store)のみを案内する。
const webOpen = ESSENCE_JOIN_OPEN;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://taroessence.com';
const pageUrl = `${siteUrl}/essence`;

// ログイン済みならダッシュボードへ、未ログインなら新規登録へ。
const joinHref = Astro.locals.isLoggedIn ? '/dashboard' : '/register';

const icons: Record<string, string> = {
  mic: '<path d="M12 2a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M19 10v1a7 7 0 0 1-14 0v-1M12 18v4M8 22h8"/>',
  file: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h6"/>',
  play: '<circle cx="12" cy="12" r="10"/><path d="M10 8l6 4-6 4z"/>',
  chat: '<path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.5 8.5 0 0 1-3.8-.9L3 21l1.9-5.2A8.4 8.4 0 1 1 21 11.5z"/>',
  box: '<path d="M21 8l-9-5-9 5v8l9 5 9-5z"/><path d="M3 8l9 5 9-5M12 13v8"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  book: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5z"/><path d="M8 7h8M8 11h5"/>',
  timer: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2M9 2h6"/>',
  yen: '<circle cx="12" cy="12" r="10"/><path d="M8 7l4 5 4-5M8 12h8M8 15h8M12 12v6"/>',
  leaf: '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10z"/><path d="M2 21c0-3 1.9-5.4 5.5-7.5"/>',
  heart: '<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"/>',
  check: '<path d="M5 13l4 4L19 7"/>',
  chevron: '<path d="M9 18l6-6-6-6"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  lock: '<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
  card: '<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/>',
  gear: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/>',
};

const forYou = [
  'やりたくないことを減らして、働き方を選び直したい人',
  'モノを手放し、お金と時間の使い方まで見直したい人',
  '会社員のまま、少しずつ選べる状態をつくりたい人',
  'フリーランスとして独立したい人',
];

const sampleItems = [
  { name: 'iPhone13mini', meta: '¥98,000 ・ 週に7回' },
  { name: 'AirPods Pro2', meta: '¥35,999 ・ 週に7回' },
  { name: 'MagSafe Wallet', meta: '¥10,853' },
];

const meditationSounds = [
  { name: '静寂', bg: 'linear-gradient(160deg,#2b2a5a,#151a33)', active: true },
  { name: 'Boundless', bg: 'linear-gradient(160deg,#14a085,#0b4d3e)', active: false },
  { name: 'Sunrise', bg: 'linear-gradient(160deg,#f59e0b,#be123c)', active: false },
];

const healthStats = [
  { value: '42,180', label: '歩数' },
  { value: '6h52m', label: '睡眠' },
  { value: '3回', label: '運動' },
];

const healthDaily = [
  { day: '月', h: 22 },
  { day: '火', h: 34 },
  { day: '水', h: 18 },
  { day: '木', h: 40 },
  { day: '金', h: 28 },
  { day: '土', h: 24 },
  { day: '日', h: 36, today: true },
];

const wave = Array.from({ length: 40 }, (_, i) => Math.round(25 + Math.abs(Math.sin(i * 1.7) * 50 + Math.cos(i * 0.9) * 20)));

const courseShowcase = [
  { id: 'minimalism', tag: 'ミニマリズム', title: '過剰からの救済 ― 5つの過剰から、選べる人生を取り戻す' },
  { id: 'web', tag: 'Webアプリ開発', title: 'バイブコーディングで、未経験からWebアプリをつくる' },
  { id: 'native', tag: 'スマホアプリ開発', title: 'バイブコーディングで、未経験からスマホアプリをリリースする' },
  { id: 'breath', tag: 'ヘルスケア', title: '呼吸から整える、毎日のメンタル・メンテナンス' },
];

const features = [
  {
    id: 'skills', en: 'Course', jp: '選ぶ力を付ける', icon: 'play', color: '#10B981',
    body: '動画形式でいつでも閲覧できる講座。見たその日からすぐに実践',
    note: '※ 月1〜2回更新。Webのダッシュボードからも視聴できます。',
  },
  {
    id: 'podcast', en: 'Podcast', jp: 'メンバー限定Podcast', icon: 'mic', color: '#34D399',
    body: 'YouTubeでは語らない実践の思考や裏側を、声でお届けします',
    note: '※ 週1回更新。',
  },
  {
    id: 'items', en: 'Item List', jp: '自身を知る', icon: 'box', color: '#34D399',
    body: '本当に必要なものを可視化するツール',
  },
  {
    id: 'meditation', en: 'Meditation Timer', jp: '頭の中を整える', icon: 'leaf', color: '#34D399',
    body: '呼吸で精神を安定させる、現代の必須科目',
  },
  {
    id: 'balance', en: 'Balance Sheet', jp: 'お金を見える化する', icon: 'yen', color: '#0891B2',
    body: '数字を把握し、不要を手放す',
  },
  {
    id: 'health', en: 'Healthcare', jp: '体の状態を知る', icon: 'heart', color: '#0D9488',
    body: '選び続けるための土台となる体を観察',
  },
  {
    id: 'community', en: 'Community', jp: '同じ方向を向く人と、比べずに話す', icon: 'chat', color: '#0D9488',
    body: 'メンバーが一定数に達したら解放します',
  },
];

const steps = [
  { n: '01', icon: 'user', t: 'アカウントを作成', d: webOpen ? 'EssenceアプリまたはWebサイトで、アカウントを作成（またはログイン）します。' : 'EssenceアプリまたはWebサイトで、アカウントを作成（またはログイン）します。' },
  { n: '02', icon: 'card', t: 'メンバーシップに登録', d: webOpen ? '月額1,500円のメンバーシップに登録します。アプリ内ではApp Store、Webサイトではクレジットカード（Stripe）でお支払いいただけます。' : 'アプリまたはWebサイトから、月額1,500円のメンバーシップに登録します。' },
];

const pricingPoints = [
  'すべての機能が使える',
  'いつでも解約可能',
];

const footerLinks = [
  { href: '/essence/info#billing', label: '課金・解約・返金について' },
  { href: '/essence/info#operator', label: 'サービス運営者情報' },
  { href: '/privacy', label: 'プライバシーポリシー' },
  { href: '/terms', label: '利用規約' },
  { href: '/tokushoho', label: '特定商取引法に基づく表記' },
];

const faq = [
  { q: '料金と支払い方法を教えてください。', a: webOpen ? '月額1,500円（税込）のメンバーシップです。初回お申し込み時とその後1か月ごとに自動で決済されます。お支払いは、アプリ内ではApp Store、Webサイトではクレジットカード（Stripe）またはApple Payです。どちらで登録しても、同じアカウントでアプリをご利用いただけます。' : '月額1,500円（税込）のメンバーシップです。アプリまたはWebサイトから登録でき、初回お申し込み時とその後1か月ごとに自動で決済されます。どちらで登録しても、同じアカウントでアプリをご利用いただけます。' },
  { q: '解約するには？ 返金はできますか？', a: (webOpen ? 'いつでも解約できます。App Storeで登録した場合はアプリの「設定」→「サブスクリプションを管理」から、Webサイトで登録した場合は「設定」→「サブスクリプションを解約する」から手続きします。' : 'いつでも解約できます。アプリの「設定」→「サブスクリプションを管理」（またはiPhoneの設定アプリ → Apple ID → サブスクリプション）から手続きします。') + '次回更新日の前日までに手続きすると、次回以降の請求は発生せず、お支払い済みの期間の終了までご利用いただけます。デジタルコンテンツの性質上、決済完了後のキャンセル・返金は行っておりません。詳細は<a href="/tokushoho" class="underline underline-offset-4 hover:text-white">特定商取引法に基づく表記</a>をご確認ください。' },
  { q: 'バランスシートや瞑想の記録は、他の人に見えますか？', a: 'いいえ。記録はGoogleのクラウド（Firebase）に暗号化して保存され、あなたのアカウントでログインしたときだけ読み書きできる設定になっています。他のメンバーや第三者に見られることはありません。' },
  { q: 'ヘルスケアのデータは、何を取得しますか？', a: '歩数・睡眠時間・ワークアウトのみを、あなたの許可のもとで「読み取り」ます。ヘルスケアへの書き込みは一切行いません。日ごとの記録はiPhone上で集計して表示し、週ごとの集計値のみをあなたのアカウントに保存します。連携はiPhoneの設定からいつでも変更できます。' },
  { q: '対応端末を教えてください。', a: 'iOS 17以降を搭載したiPhoneに対応しています。Android版も今後リリースを予定しています。' },
  { q: 'Courseはパソコンでも見られますか？', a: 'はい。Webサイトにログインすると、ダッシュボードからCourseを視聴できます。アプリと同じアカウントで利用でき、進み具合も共通です。' },
  { q: '問い合わせ先はどこですか？', a: '<a href="mailto:hello@taroessence.com" class="underline underline-offset-4 hover:text-white">hello@taroessence.com</a> までご連絡ください（対応時間: 10:00〜18:00 土日祝日を除く）。' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Essence',
  url: pageUrl,
  operatingSystem: 'iOS 17+',
  applicationCategory: 'LifestyleApplication',
  description: 'Essenceは、やりたくないことを減らし、自由な時間とお金を増やしていくための考え方と道具をまとめたメンバー向けアプリケーション。Podcast、スキル講座、記事、コミュニティ、持ち物リスト、お金と時間の記録ツール。月額1,500円（税込）。',
  image: `${siteUrl}/assets/essence/app-icon.png`,
  offers: {
    '@type': 'Offer',
    price: '1500',
    priceCurrency: 'JPY',
    description: '月額メンバーシップ（税込・1か月ごとの自動更新）',
  },
  publisher: { '@type': 'Person', name: 'Taro Essence', url: siteUrl },
};
---

<Layout
  title="Essence｜選べる人生を、創る。"
  description="Essenceは、やりたくないことを減らし、自由な時間とお金を増やしていくための考え方と道具をまとめたメンバー向けアプリケーション。Podcast、スキル講座、記事、コミュニティ、持ち物リスト、お金と時間の記録ツール。月額1,500円（税込）。"
  keywords="Essence, Taro Essence, ミニマリズム, 習慣, セルフマネジメント, Podcast, スキル, アプリケーション, 働き方, サイドFIRE"
  ogImage="/assets/essence/app-icon.png"
>
  <script is:inline>document.documentElement.classList.add('js-reveal');</script>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="essence-page relative isolate bg-black text-white font-normal overflow-x-clip selection:bg-emerald-300 selection:text-black">

    <div class="relative z-10 px-5 md:px-8 pt-6">
      <BackToHome />
    </div>

    {/* ページ全体に敷く1枚のグラデーション。セクションごとに区切らず、全体を一体に見せる */}
    <div class="page-aurora" aria-hidden="true">
      <span class="pa" style="--pc:16,185,129;--w:760px;--o:.85;left:-24%;top:0%"></span>
      <span class="pa" style="--pc:8,145,178;--w:700px;--o:.75;right:-22%;top:2%;animation-delay:-6s"></span>
      <span class="pa" style="--pc:52,211,153;--w:620px;--o:.32;left:24%;top:9%;animation-delay:-11s"></span>
      <span class="pa" style="--pc:13,148,136;--w:720px;--o:.5;right:-24%;top:27%"></span>
      <span class="pa" style="--pc:16,185,129;--w:760px;--o:.5;left:-26%;top:46%;animation-delay:-9s"></span>
      <span class="pa" style="--pc:8,145,178;--w:720px;--o:.5;right:-24%;top:63%;animation-delay:-4s"></span>
      <span class="pa" style="--pc:52,211,153;--w:760px;--o:.4;left:14%;top:79%"></span>
      <span class="pa" style="--pc:8,145,178;--w:760px;--o:.55;right:-14%;top:91%;animation-delay:-13s"></span>
    </div>

    {/* ───────────── Hero ───────────── */}
    <section class="hero relative pt-28 md:pt-36 pb-20 md:pb-28">

      <div class="max-w-6xl mx-auto px-5 md:px-8 grid grid-cols-[1.3fr_0.7fr] sm:grid-cols-[1.1fr_0.9fr] gap-3 sm:gap-8 items-center">
        <div class="min-w-0">

          <h1 class="reveal whitespace-nowrap text-xl min-[400px]:text-2xl sm:text-3xl lg:text-5xl font-bold tracking-tight leading-tight" style="--d:80ms">
            選べる人生を、<span class="gradient-text">創る</span>
          </h1>

          <p class="reveal mt-4 sm:mt-7 text-[13px] leading-relaxed sm:text-sm md:text-base text-zinc-300 max-w-xl" style="--d:160ms">
            やりたくないことを減らし、自由な時間とお金を増やしていく。
            Essenceは、そのための考え方と道具をまとめた、メンバーのためのアプリケーションです。
          </p>

          <div class="reveal mt-5 sm:mt-9 flex flex-wrap items-center gap-2 sm:gap-3" style="--d:240ms">
            <EssenceDownloadButton href={joinHref} />
            <a href="#features" class="inline-flex items-center justify-center rounded-full border border-white/15 bg-white/[0.03] px-4 py-2 text-[13px] sm:px-7 sm:py-3.5 sm:text-sm font-bold text-white hover:bg-white/10 transition-colors">
              機能を見る
            </a>
          </div>
        </div>

        {/* Phone: Home screen */}
        <div class="hero-phone reveal relative min-w-0 mx-auto lg:ml-auto" style="--d:200ms">
          <div class="phone-glow" aria-hidden="true"></div>
          <div class="phone float" role="img" aria-label="Essenceのホーム画面のイメージ">
            <img src="/assets/essence/home-device.png" alt="" class="phone-device" width="838" height="1698" loading="eager" decoding="async" />
          </div>
        </div>
      </div>
    </section>

    {/* ───────────── For You ───────────── */}
    <section id="for-you" class="max-w-4xl mx-auto px-5 md:px-8 pb-14 md:pb-20">
      <div class="reveal rounded-3xl border border-white/10 bg-white/[0.03] px-5 py-7 md:p-10">
        <p class="eyebrow text-center">For You</p>
        <h2 class="mt-3 text-center text-lg sm:text-xl md:text-2xl font-bold tracking-tight">こんな人のために</h2>
        <ul class="mt-7 md:mt-8 space-y-3.5 md:space-y-4 max-w-xl mx-auto">
          {forYou.map((item) => (
            <li class="flex items-start gap-3 text-sm md:text-base text-zinc-200 leading-relaxed">
              <svg viewBox="0 0 24 24" fill="none" stroke="#34D399" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0 mt-0.5" set:html={icons.check} />
              {item}
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ───────────── Features ───────────── */}
    <section id="features" class="max-w-4xl mx-auto px-5 md:px-8 py-14 md:py-32">
      <div class="text-center mb-8 md:mb-14">
        <p class="reveal eyebrow">Features</p>
        <h2 class="reveal mt-5 text-2xl md:text-3xl font-bold tracking-tight" style="--d:80ms">ひとつのアプリで、時間とお金を取り戻す</h2>
      </div>

      <div class="grid gap-2 md:gap-4">
        {features.map((f) => (
          <article class="feature-card card reveal p-4 md:p-7 flex flex-col" style={`--c:${f.color}`}>
            <div class="contents md:flex md:items-center md:gap-3 md:mb-5">
              <span class="icon-chip" style={`--c:${f.color}`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" set:html={icons[f.icon]} />
              </span>
              <span class="text-[10px] md:text-xs font-bold tracking-[0.2em] uppercase text-zinc-400">{f.en}</span>
            </div>
            <h3 class="mt-0.5 md:mt-0 text-base md:text-lg font-bold tracking-tight leading-snug">{f.jp}</h3>
            <p class="mt-1 md:mt-3 text-[13px] md:text-sm leading-[1.7] md:leading-[1.9] text-zinc-400 md:flex-1">{f.body}</p>
            {f.note && <p class="mt-1.5 md:mt-2 text-xs font-bold text-emerald-300/80">{f.note}</p>}

            {/* 各カードの高さを揃えるため、ミニUIは固定高さの枠に収める */}
            <div class="feature-visual mt-4 md:mt-6" aria-hidden="true">
              {f.id === 'podcast' && (
                <div class="text-[10px]">
                  <p class="font-bold tracking-[0.2em] text-emerald-400 text-[8px]">NOW PLAYING</p>
                  <p class="mt-1 text-zinc-500">EP 2 ・ 10分</p>
                  <p class="mt-0.5 text-sm font-bold text-zinc-100">30代の投資戦略</p>
                  <div class="mt-3 flex items-center gap-[3px] h-9">
                    {wave.map((h, k) => (
                      <span class={`flex-1 min-w-[2px] rounded-full ${k < wave.length * 0.35 ? 'bg-emerald-400' : 'bg-white/15'}`} style={`height:${h}%`}></span>
                    ))}
                  </div>
                  <div class="mt-1.5 flex justify-between text-zinc-500 tabular-nums"><span>03:12</span><span>10:00</span></div>
                  <div class="mt-2 flex items-center justify-center gap-6 text-zinc-300">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M11 17l-5-5 5-5M18 17l-5-5 5-5" /></svg>
                    <span class="w-9 h-9 rounded-full flex items-center justify-center bg-emerald-400 text-black">
                      <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M7 5h4v14H7zM13 5h4v14h-4z" /></svg>
                    </span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M13 17l5-5-5-5M6 17l5-5-5-5" /></svg>
                  </div>
                </div>
              )}

              {f.id === 'skills' && (
                <div class="course-carousel">
                  <div class="course-marquee">
                    <div class="course-track">
                      {courseShowcase.map((c) => (
                        <div class="course-slide">
                          <img src={`/assets/essence/course-thumb-${c.id}.jpg`} alt="" width="640" height="360" loading="lazy" decoding="async" />
                          <span class="course-tag">{c.tag}</span>
                          <p class="course-title">{c.title}</p>
                        </div>
                      ))}
                    </div>
                  </div>
                  {[-1, 1].map((dir) => (
                    <button type="button" class={`course-arrow ${dir < 0 ? 'prev' : 'next'}`} data-dir={dir} tabindex="-1" disabled={dir < 0}>
