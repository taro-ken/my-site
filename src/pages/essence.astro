---
import Layout from '../layouts/Layout.astro';
import EssenceDownloadButton from '../components/EssenceDownloadButton.astro';

// App Store公開後にURLを入れると、各所のダウンロードボタンが有効になる(未設定の間は「App Storeで近日公開」の表示)。
const APP_STORE_URL = '';

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://kentaro.life';
const pageUrl = `${siteUrl}/essence`;

const icons: Record<string, string> = {
  mic: '<path d="M12 2a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M19 10v1a7 7 0 0 1-14 0v-1M12 18v4M8 22h8"/>',
  file: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h6"/>',
  play: '<circle cx="12" cy="12" r="10"/><path d="M10 8l6 4-6 4z"/>',
  chat: '<path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.5 8.5 0 0 1-3.8-.9L3 21l1.9-5.2A8.4 8.4 0 1 1 21 11.5z"/>',
  box: '<path d="M21 8l-9-5-9 5v8l9 5 9-5z"/><path d="M3 8l9 5 9-5M12 13v8"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  book: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5z"/><path d="M8 7h8M8 11h5"/>',
  timer: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2M9 2h6"/>',
  yen: '<circle cx="12" cy="12" r="10"/><path d="M8 7l4 5 4-5M8 12h8M8 15h8M12 12v6"/>',
  leaf: '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10z"/><path d="M2 21c0-3 1.9-5.4 5.5-7.5"/>',
  heart: '<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"/>',
  check: '<path d="M5 13l4 4L19 7"/>',
  chevron: '<path d="M9 18l6-6-6-6"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  lock: '<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
  card: '<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/>',
  gear: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/>',
};

const homeSections = [
  {
    label: '学ぶ',
    rows: [
      { t: 'Podcast', d: '考え方を耳から学ぶ。' },
      { t: 'Skills', d: '章立ての動画講座で学ぶ。' },
      { t: 'Article', d: '暮らしと働き方を綴る記事。' },
    ],
  },
  {
    label: '使う',
    rows: [
      { t: 'Item List', d: '持ち物を見える化する。' },
      { t: 'Personal', d: 'お金と時間を自分で把握する。' },
    ],
  },
  {
    label: '話す',
    rows: [
      { t: 'Community', d: '同じ方向を向く人と話す。' },
    ],
  },
];

const forYou = [
  '今の働き方に、やりたくないことが多すぎると感じている',
  'モノを減らすだけでなく、お金や時間の使い方まで見直したい',
  'いきなり独立はしないけれど、選べる状態を少しずつつくりたい',
];

const wave = Array.from({ length: 34 }, (_, i) => Math.round(22 + Math.abs(Math.sin(i * 1.7) * 55 + Math.cos(i * 0.9) * 20)));

const features = [
  {
    id: 'podcast', en: 'Podcast', jp: '考え方を、耳から。', icon: 'mic', color: '#34D399',
    body: '選べる人生を創るための考え方を、音声で。家事や移動の時間が、そのまま次の一歩を考える時間になります。',
  },
  {
    id: 'skills', en: 'Skills', jp: '方法を、順番に学ぶ。', icon: 'play', color: '#10B981',
    body: '削る・創る・選ぶという方法を、動画講座で身につける。知って終わりにせず、実際に手を動かせるところまで連れていきます。',
  },
  {
    id: 'article', en: 'Article', jp: '暮らしと働き方を綴る。', icon: 'file', color: '#0891B2',
    body: 'ミニマリズム、お金、仕事の選び方について。今の働き方を見直すきっかけになる考えを、文章でじっくり届けます。',
  },
  {
    id: 'items', en: 'Item List', jp: '持ち物を、見える化する。', icon: 'box', color: '#34D399',
    body: '持っているものを記録し、本当に必要なものだけを残す。持ち物が減るほど、管理する時間もお金も浮き、選べる余白が増えていきます。',
  },
  {
    id: 'personal', en: 'Personal', jp: 'お金と時間を、自分で把握する。', icon: 'user', color: '#0891B2',
    body: 'お金と時間の使い方を、感覚ではなく記録で確認する。何を減らし、何に使うかを、自分の意思で選べるようになります。',
  },
  {
    id: 'community', en: 'Community', jp: '同じ方向を向く人と、比べずに話す。', icon: 'chat', color: '#0D9488',
    body: 'メンバーだけが話せる、小さな場所です。同じ方向を目指す人の存在が、迷ったときに一歩を踏み出す力になります。',
  },
];

const personalTools = [
  { icon: 'yen', c: '#0891B2', t: 'バランスシート', d: '資産と負債を書き出し、純資産をひと目で把握。お金の不安が減るほど、働き方も選びやすくなります。' },
  { icon: 'timer', c: '#10B981', t: 'ディープワーク', d: '集中した時間を計測し、記録に残す。積み上げた時間が、次に何を学び何を手放すかの土台になります。' },
  { icon: 'book', c: '#0D9488', t: 'ジャーナル', d: '日々の思考や出来事を書き留める。書き出すほど、本当にやりたいこと・やりたくないことがはっきりします。' },
  { icon: 'leaf', c: '#34D399', t: '瞑想', d: '5分からのタイマーで、頭の中を一度整理する。判断に迷ったときほど、静かな時間が次の選択を助けます。' },
  { icon: 'heart', c: '#0D9488', t: 'ヘルスケア連携', d: '歩数・睡眠・ワークアウトを週単位で確認（読み取り専用）。心と体の状態を把握することも、選べる状態の土台になります。' },
];

const personalCards = [
  { t: 'バランスシート', icon: 'yen', c: '#0891B2', cap: '純資産', v: '¥1,250,000', u: '' },
  { t: 'ディープワーク', icon: 'timer', c: '#10B981', cap: '今日の合計', v: '1h25m', u: '' },
  { t: 'ジャーナル', icon: 'book', c: '#0D9488', cap: '記録した数', v: '12', u: '件' },
  { t: '瞑想', icon: 'leaf', c: '#34D399', cap: '今週', v: '3', u: '回' },
  { t: 'ヘルスケア', icon: 'heart', c: '#0D9488', cap: '今週の歩数', v: '42,180', u: '歩' },
];

const steps = [
  { n: '01', icon: 'user', t: 'アカウントを作成', d: 'Essenceアプリを開き、アカウントを作成（またはログイン）します。' },
  { n: '02', icon: 'card', t: 'メンバーシップに登録', d: 'アプリ内の案内から、月額990円のメンバーシップに登録します。決済はStripeで安全に処理されます。' },
  { n: '03', icon: 'leaf', t: 'すべての機能を使う', d: 'ホーム画面から、Podcast・Article・Skills・Community・Item List・Personalへ。' },
];

const pricingPoints = [
  'Podcast・Skills（動画講座）を含む、すべての機能が使える',
  'Communityへの参加',
  'Personal（ジャーナル・ディープワーク・バランスシート・瞑想・ヘルスケア連携）',
  'アプリの「設定」からいつでも解約可能',
];

const billingTerms = [
  { k: '課金', v: '初回お申し込み時、およびその後1か月ごとに自動更新されます。' },
  { k: '解約', v: 'アプリの「設定」→「サブスクリプションを解約する」からいつでも可能です。次回更新日の前日までに手続きすると、次回以降の請求は発生しません。手続き完了後は、直ちにご利用が終了します。' },
  { k: '返金', v: 'デジタルコンテンツの性質上、決済完了後のキャンセル・返金は行っておりません。' },
  { k: 'お支払い', v: 'クレジットカード（Stripe）／ Apple Pay' },
];

const faq = [
  { q: 'Essenceとは、どんなアプリですか？', a: 'やりたくないことを減らし、自由な時間とお金を増やしていくための、メンバー向けアプリケーションです。音声（Podcast）、スキル講座（Skills）、記事（Article）でまず学び、持ち物の記録（Item List）やお金・時間を把握するツール（Personal）を使い、同じ方向を向くメンバーと話せる場（Community）まで、1つにまとめています。' },
  { q: '料金と支払い方法を教えてください。', a: '月額990円（税込）のメンバーシップです。お支払いはクレジットカード（Stripe）またはApple Payで、初回お申し込み時とその後1か月ごとに自動で決済されます。登録はアプリ内から行います。' },
  { q: '解約するには？ 返金はできますか？', a: 'アプリの「設定」→「サブスクリプションを解約する」からいつでも解約できます。次回更新日の前日までに手続きすると、次回以降の請求は発生しません。デジタルコンテンツの性質上、決済完了後のキャンセル・返金は行っておりません。詳細は<a href="/tokushoho" class="underline underline-offset-4 hover:text-white">特定商取引法に基づく表記</a>をご確認ください。' },
  { q: 'Personalに記録した内容は、他の人に見えますか？', a: 'いいえ。ジャーナル、ディープワーク、バランスシート、瞑想の記録は、あなたのアカウントにのみ紐づいて保存され、他のメンバーには表示されません。' },
  { q: 'ヘルスケアのデータは、何を取得しますか？', a: '歩数・睡眠時間・ワークアウトのみを、あなたの許可のもとで「読み取り」ます。ヘルスケアへの書き込みは一切行いません。表示のために、週ごとの集計値をあなたのアカウントに保存します。連携はiPhoneの設定からいつでも変更できます。' },
  { q: 'Communityでの不適切な投稿はどうなりますか？', a: 'Communityはメンバー限定の場です。不適切な投稿は運営が確認のうえ削除します。ご自身の投稿は、いつでもご自身で削除できます。' },
  { q: '対応端末を教えてください。', a: 'iOS 17以降を搭載したiPhoneに対応しています。Android版も今後リリースを予定しています。' },
  { q: '問い合わせ先はどこですか？', a: '<a href="mailto:minimal@kentaro.life" class="underline underline-offset-4 hover:text-white">minimal@kentaro.life</a> までご連絡ください（対応時間: 10:00〜18:00 土日祝日を除く）。' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Essence',
  url: pageUrl,
  operatingSystem: 'iOS 17+',
  applicationCategory: 'LifestyleApplication',
  description: 'Essenceは、やりたくないことを減らし、自由な時間とお金を増やしていくための考え方と道具をまとめたメンバー向けアプリケーション。Podcast、スキル講座、記事、コミュニティ、持ち物リスト、お金と時間の記録ツール。月額990円（税込）。',
  image: `${siteUrl}/assets/essence/app-icon.png`,
  offers: {
    '@type': 'Offer',
    price: '990',
    priceCurrency: 'JPY',
    description: '月額メンバーシップ（税込・1か月ごとの自動更新）',
  },
  publisher: { '@type': 'Person', name: 'Taro Essence', url: siteUrl },
};
---

<Layout
  title="Essence｜選べる人生を、創る。考え方と道具のアプリケーション - taro."
  description="Essenceは、やりたくないことを減らし、自由な時間とお金を増やしていくための考え方と道具をまとめたメンバー向けアプリケーション。Podcast、スキル講座、記事、コミュニティ、持ち物リスト、お金と時間の記録ツール。月額990円（税込）。"
  keywords="Essence, Taro Essence, ミニマリズム, 習慣, セルフマネジメント, Podcast, スキル, アプリケーション, 働き方, サイドFIRE"
  ogImage="/assets/essence/app-icon.png"
>
  <script is:inline>document.documentElement.classList.add('js-reveal');</script>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="essence-page relative isolate bg-black text-white font-normal overflow-x-clip selection:bg-emerald-300 selection:text-black">

    {/* ページ全体に敷く1枚のグラデーション。セクションごとに区切らず、全体を一体に見せる */}
    <div class="page-aurora" aria-hidden="true">
      <span class="pa" style="--pc:16,185,129;--w:760px;--o:.85;left:-24%;top:0%"></span>
      <span class="pa" style="--pc:8,145,178;--w:700px;--o:.75;right:-22%;top:2%;animation-delay:-6s"></span>
      <span class="pa" style="--pc:52,211,153;--w:620px;--o:.32;left:24%;top:9%;animation-delay:-11s"></span>
      <span class="pa" style="--pc:13,148,136;--w:720px;--o:.5;right:-24%;top:27%"></span>
      <span class="pa" style="--pc:16,185,129;--w:760px;--o:.5;left:-26%;top:46%;animation-delay:-9s"></span>
      <span class="pa" style="--pc:8,145,178;--w:720px;--o:.5;right:-24%;top:63%;animation-delay:-4s"></span>
      <span class="pa" style="--pc:52,211,153;--w:760px;--o:.4;left:14%;top:79%"></span>
      <span class="pa" style="--pc:8,145,178;--w:760px;--o:.55;right:-14%;top:91%;animation-delay:-13s"></span>
    </div>

    {/* ───────────── Hero ───────────── */}
    <section class="hero relative pt-28 md:pt-36 pb-20 md:pb-28">

      <div class="max-w-6xl mx-auto px-5 md:px-8 grid grid-cols-[1.3fr_0.7fr] sm:grid-cols-[1.1fr_0.9fr] gap-3 sm:gap-8 items-center">
        <div class="min-w-0">

          <h1 class="reveal text-[1.65rem] min-[380px]:text-3xl sm:text-6xl lg:text-7xl font-black tracking-tight leading-[1.15] sm:leading-[1.08]" style="--d:80ms">
            選べる人生を、<br />
            <span class="gradient-text">創る。</span>
          </h1>

          <p class="reveal mt-4 sm:mt-7 text-[11px] leading-[1.7] sm:text-base md:text-lg sm:leading-relaxed text-zinc-300 max-w-xl" style="--d:160ms">
            やりたくないことを減らし、自由な時間とお金を増やしていく。
            Essenceは、そのための考え方と道具をまとめた、メンバーのためのアプリケーションです。
          </p>

          <div class="reveal mt-5 sm:mt-9 flex flex-wrap items-center gap-2 sm:gap-3" style="--d:240ms">
            <EssenceDownloadButton href={APP_STORE_URL} />
            <a href="#features" class="inline-flex items-center justify-center rounded-full border border-white/15 bg-white/[0.03] px-4 py-2 text-[11px] sm:px-7 sm:py-3.5 sm:text-sm font-bold text-white hover:bg-white/10 transition-colors">
              機能を見る
            </a>
          </div>

          <ul class="reveal mt-5 sm:mt-8 flex flex-wrap gap-x-4 sm:gap-x-6 gap-y-1.5 sm:gap-y-2 text-[10px] sm:text-xs text-zinc-400" style="--d:320ms">
            <li class="flex items-center gap-2"><span class="dot"></span>iPhone（iOS 17以降）</li>
            <li class="flex items-center gap-2"><span class="dot"></span>月額 ¥990（税込）</li>
            <li class="flex items-center gap-2"><span class="dot"></span>いつでも解約可能</li>
            <li><a href="#pricing" class="underline underline-offset-4 text-zinc-300 hover:text-white transition-colors">料金・解約について</a></li>
          </ul>
          <p class="reveal mt-3 sm:mt-4 text-[10px] sm:text-[11px] text-zinc-500" style="--d:380ms">Android版も今後リリース予定です。</p>
        </div>

        {/* Phone: Home screen */}
        <div class="hero-phone reveal relative min-w-0 mx-auto lg:ml-auto" style="--d:200ms">
          <div class="phone-glow" aria-hidden="true"></div>
          <div class="phone float" role="img" aria-label="Essenceのホーム画面のイメージ">
            <div class="phone-bezel">
              <div class="phone-screen">
                <div class="island"></div>
                <div class="screen-aurora a"></div>
                <div class="screen-aurora b"></div>
                <div class="home">
                  <div class="home-head">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#34D399" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" set:html={icons.leaf} />
                    <p>Essence</p>
                  </div>
                  {homeSections.map((sec) => (
                    <div class="home-sec">
                      <div class="home-sec-label"><span>{sec.label}</span><i></i></div>
                      {sec.rows.map((r) => (
                        <div class="home-row">
                          <p class="t">{r.t}</p>
                          <p class="d">{r.d}</p>
                        </div>
                      ))}
                    </div>
                  ))}
                  <div class="home-row settings">
                    <p class="t">Settings</p>
                    <p class="d">アカウント・外観・外部連携の管理。</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ───────────── For You ───────────── */}
    <section id="for-you" class="max-w-4xl mx-auto px-5 md:px-8 pb-14 md:pb-20">
      <div class="reveal rounded-3xl border border-white/10 bg-white/[0.03] p-7 md:p-10">
        <p class="eyebrow text-center">For You</p>
        <h2 class="mt-3 text-center text-xl sm:text-2xl md:text-3xl font-black tracking-tight">こんな人のために</h2>
        <ul class="mt-7 md:mt-8 space-y-3.5 md:space-y-4 max-w-xl mx-auto">
          {forYou.map((item) => (
            <li class="flex items-start gap-3 text-sm md:text-base text-zinc-200 leading-relaxed">
              <svg viewBox="0 0 24 24" fill="none" stroke="#34D399" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0 mt-0.5" set:html={icons.check} />
              {item}
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ───────────── Features ───────────── */}
    <section id="features" class="max-w-6xl mx-auto px-5 md:px-8 py-14 md:py-32">
      <div class="text-center mb-8 md:mb-14">
        <p class="reveal eyebrow">Features</p>
        <h2 class="reveal mt-5 text-3xl md:text-5xl font-black tracking-tight" style="--d:80ms">ひとつのアプリで、整える。</h2>
      </div>

      <div class="grid gap-2 md:gap-5 md:grid-cols-2 lg:grid-cols-3 md:auto-rows-fr">
        {features.map((f) => (
          <article class="feature-card card reveal p-3 md:p-7 grid grid-cols-[2rem_1fr] gap-x-3 gap-y-0.5 md:flex md:flex-col" style={`--c:${f.color}`}>
            <div class="contents md:flex md:items-center md:gap-3 md:mb-5">
              <span class="icon-chip row-span-3 self-start md:row-auto" style={`--c:${f.color}`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" set:html={icons[f.icon]} />
              </span>
              <span class="col-start-2 text-[9px] md:text-xs font-bold tracking-[0.2em] uppercase text-zinc-400">{f.en}</span>
            </div>
            <h3 class="col-start-2 text-sm md:text-2xl font-black tracking-tight leading-snug">{f.jp}</h3>
